// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// APEX Fusion Pro — one engine built from two indicators:
//   • APEX Focus: multi-timeframe trend engine, 7-point confluence score, Donchian / SuperTrend
//     triggers, swing stops, multi-target management, regression channel, pivot trendlines, zones.
//   • Setup Scanner [GBB]: break & retest, opening range, EMA pullback, VWAP reclaim, liquidity
//     sweep and RSI divergence setups, trade-zone drawing and a per-setup scoreboard.
// Fusion rules (chosen on in-sample gold data, then checked out of sample — see reports/):
//   trend setups need  anchor trend (Daily on intraday charts) + HTF trend (4H on 5m/15m/1H)
//   + APEX score >= 5 + active session (08:00-17:00 New York, metals/FX/commodities/stocks).
//   Below 1H a professional execution pack is added: pullback limit entry (33% of the stop
//   distance, valid 3 bars), no signal bar wider than 2.5 ATR, and a volatility floor (stop >= 0.43%
//   of price). Default management below 1H: Max Win-Rate (0.4R / 1.5R / 4R, 60% off at TP1).
//   Reversal setups (sweep, divergence, zone rebound) are available but off by default: they lost
//   money in every gold test.
// Non-repainting: entries are evaluated on confirmed bars only; HTF / anchor data use the previous
// completed bar (expression[1] + lookahead_on). Pivots, zones and trendlines are drawn back at the
// pivot bar once confirmed; the regression channel is recalculated on the last bar.
// The performance panel is an OHLC simulation (entry at the signal close, or at the limit fill below
// 1H; stop-first when a bar touches both stop and target; round-trip cost subtracted). Not broker execution.
//
// v2 changes (measurements: apex/REPORT_FUSION.md in the repository):
//  * compiler warnings removed: one titled input per inline row (CW10026);
//  * two new management profiles: Sniper (0.2R, the new Auto choice below 1H) and Shield (0.05R, for gold on
//    1H and above); a smaller first target raises the win rate and lowers the profit per trade;
//  * simulation: every managed bar is replayed on intrabar data where TradingView has it, and a stop that a
//    fill on the same bar has just raised is filled when that bar closes through it;
//  * alerts: the exit / target event carries its side, the targets filled on the bar and the real fill price,
//    a stop at the initial stop is always a STOP, and events are sent before the new signal;
//  * crypto symbols typed "spot" / "swap" are treated as crypto; trendlines are anchored by time.
//@version=6
indicator("APEX Fusion Pro", shorttitle = "APEX FUSION", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 1000)

// ───────────────────────────── Inputs ─────────────────────────────
const string G_SIG  = "① Signal engine"
const string G_LTF  = "①b Execution below 1H (5m / 15m)"
const string G_SET  = "② Entry setups"
const string G_RISK = "③ Stop & targets"
const string G_VIS  = "④ Trade drawing"
const string G_STR  = "⑤ Trend, channel & zones"
const string G_SES  = "⑤b Market sessions (display only)"
const string G_PNL  = "⑥ Performance panel"
const string G_SIZE = "⑦ Cost & position sizing"

const string PROF_AUTO = "Auto (below 1H: Sniper · 1H and above: High Win-Rate)"
const string PROF_SHD = "Shield (0.05R / 1.5R / 4R) — gold 1H and above"
const string PROF_SNP = "Sniper (0.2R / 1.5R / 4R)"
const string PROF_MW  = "Max Win-Rate (0.4R / 1.5R / 4R)"
const string PROF_BAL = "Balanced Pro (1R / 3R / 5R)"
const string PROF_HW  = "High Win-Rate (0.5R / 2R / 5R)"
const string PROF_HP  = "APEX High-Probability (0.3R / 1.5R / 4R + trail)"
const string PROF_RUN = "Trend Runner (1R / 2R / 8R + trail)"
const string PROF_CUS = "Custom"

lang        = input.string("العربية", "Language / اللغة", options = ["العربية", "English"], group = G_SIG)
assetIn     = input.string("Auto", "Asset class", options = ["Auto", "Metals / FX / Commodities", "Crypto", "Stocks / Indices"], group = G_SIG, tooltip = "Auto reads syminfo.type. It sets the round-trip cost, the active-session filter (off for crypto) and the opening-range session. The defaults were designed and validated on gold only; on silver, BTC/ETH/SOL and 8 US stocks they lost money in testing (see reports/).")
minScore    = input.int(5, "Minimum APEX confluence score (0-7)", minval = 0, maxval = 7, group = G_SIG, tooltip = "Counts aligned conditions: HTF trend, EMA200 side, EMA21/55 order, ADX threshold, ADX rising, DI alignment, RSI side. Applies to trend setups. It is not a win probability.")
useAnchor   = input.bool(true, "Anchor trend must agree (Daily on intraday charts)", group = G_SIG, tooltip = "The strongest filter in the gold tests: signals against or without a Daily trend lost money.")
useHtfGate  = input.bool(true, "HTF trend must agree (4H on 5m / 15m / 1H)", group = G_SIG)
sessIn      = input.string("Auto", "Active-session filter", options = ["Auto", "On", "Off"], group = G_SIG, inline = "ss", tooltip = "Auto: on for metals, FX, commodities and stocks; off for crypto. Applies to charts below 4H. Gold signals between 00:00 and 05:00 New York lost money in all three test feeds.")
sessStr     = input.session("0800-1700", "", group = G_SIG, inline = "ss")
sessTz      = input.string("America/New_York", "Session timezone", group = G_SIG)
dirMode     = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = G_SIG)
adxMin      = input.float(25.0, "ADX trend threshold", minval = 5, step = 1, group = G_SIG)
htfMode     = input.string("Auto", "Higher timeframe", options = ["Auto", "Custom"], group = G_SIG, inline = "htf", tooltip = "Auto: ≤1H→4H (5m charts use 4H too, so 5m only times the entry), ≤4H→1D, 1D→1W, above→1M")
htfCustom   = input.timeframe("240", "", group = G_SIG, inline = "htf")
anchorMode  = input.string("Auto", "Anchor timeframe", options = ["Auto", "Custom"], group = G_SIG, inline = "anc", tooltip = "Auto: ≤1H→1D, ≤4H→1W, above→1M")
anchorCustom = input.timeframe("D", "", group = G_SIG, inline = "anc")
reverseOn   = input.bool(true, "Opposite signal reverses an open trade", group = G_SIG)

ltfPack     = input.bool(true, "Professional execution pack below 1H", group = G_LTF, tooltip = "On charts below 1H: enter with a limit order on a pullback instead of chasing the close, skip news/exhaustion candles and require a minimum volatility. In the gold tests this raised the 5m/15m win rate from ~55-67% to ~70-82%.")
pbFrac      = input.float(0.33, "Pullback entry: limit at × stop distance · valid bars", minval = 0.05, maxval = 0.9, step = 0.01, group = G_LTF, inline = "pb", tooltip = "After a signal, a limit order is placed this fraction of the stop distance back toward the stop. Risk and targets are measured from the fill. Signals whose limit is not filled are marked ✗ and are not trades.")
pbBars      = input.int(3, "", minval = 1, maxval = 20, group = G_LTF, inline = "pb")
maxBarAtr   = input.float(2.5, "Skip signal bars wider than × ATR", minval = 0.5, step = 0.1, group = G_LTF)
minStopPct  = input.float(0.43, "Volatility floor: stop must be ≥ % of price", minval = 0, step = 0.01, group = G_LTF, tooltip = "Signals with a tighter stop come from quiet, noisy markets; they lowered results in every in-sample test.")

useBrt      = input.bool(true, "Break & retest (GBB)", group = G_SET)
useOrb      = input.bool(true, "Opening-range break (GBB)", group = G_SET)
useBrk      = input.bool(true, "Donchian breakout (APEX) · length", group = G_SET, inline = "brk")
donLen      = input.int(20, "", minval = 5, group = G_SET, inline = "brk")
useEma      = input.bool(true, "EMA 9/21 pullback (GBB)", group = G_SET)
usePb       = input.bool(true, "SuperTrend pullback resume (APEX)", group = G_SET)
useFlip     = input.bool(true, "SuperTrend flip (APEX) · factor · ATR length", group = G_SET, inline = "st")
stFactor    = input.float(3.0, "", minval = 0.5, step = 0.1, group = G_SET, inline = "st")
stLen       = input.int(10, "", minval = 1, group = G_SET, inline = "st")
useVwap     = input.bool(true, "VWAP reclaim (GBB)", group = G_SET)
useSweep    = input.bool(false, "Liquidity sweep reversal (GBB)", group = G_SET, tooltip = "Off by default: negative expectancy in every gold test, with or without trend alignment.")
useDiv      = input.bool(false, "RSI divergence (GBB)", group = G_SET, tooltip = "Off by default: negative expectancy in the gold tests.")
useReb      = input.bool(false, "Zone rebound / rejection (APEX)", group = G_SET, tooltip = "APEX support-rebound watch turned into a two-sided setup. Off by default: negative expectancy in the gold tests.")
volMult     = input.float(1.0, "Volume must exceed × SMA20 (VWAP, EMA, sweep)", minval = 0, step = 0.1, group = G_SET)
pvLen       = input.int(5, "Swing pivot length (B&R, divergence)", minval = 2, group = G_SET)
vwapAway    = input.int(6, "VWAP: min bars on the other side", minval = 1, group = G_SET)
emaWindow   = input.int(3, "EMA: bars since touch", minval = 1, group = G_SET)
brtTol      = input.float(0.3, "Retest tolerance (ATR)", minval = 0.05, step = 0.05, group = G_SET)
brtWindow   = input.int(20, "Retest window (bars)", minval = 2, group = G_SET)
sweepLen    = input.int(20, "Sweep lookback", minval = 5, group = G_SET)
divGap      = input.int(60, "Divergence max pivot gap", minval = 5, group = G_SET)
orbMode     = input.string("Auto", "Opening-range session", options = ["Auto", "Custom"], group = G_SET, inline = "orb", tooltip = "Auto: 09:30-16:00 New York; crypto 00:00-23:00 UTC.")
orSessIn    = input.session("0930-1600", "", group = G_SET, inline = "orb")
orTzIn      = input.string("America/New_York", "Opening-range timezone (Custom)", group = G_SET)
orMin       = input.int(15, "Opening-range length (minutes)", minval = 1, group = G_SET)
bounceWindow = input.int(3, "Rebound confirmation window (bars)", minval = 1, maxval = 10, group = G_SET)

profileIn   = input.string(PROF_AUTO, "Trade-management profile", options = [PROF_AUTO, PROF_SHD, PROF_SNP, PROF_MW, PROF_HW, PROF_BAL, PROF_HP, PROF_RUN, PROF_CUS], group = G_RISK, tooltip = "Auto: Sniper below 1H, High Win-Rate on 1H and above. Measured on gold in the backtests (apex/REPORT_FUSION.md): Sniper (TP1 0.2R closes 60%, stop to breakeven) won about 88% of 5m/15m trades against about 72% for Max Win-Rate, with a profit factor near 1.2 on a small sample. Shield (TP1 0.05R closes 50%, stop to breakeven) won about 91% on 1H and 94% on 4H/1D gold, but most of those wins are near-breakeven scratches; below 1H the trading cost turns them into losses. Max Win-Rate: 0.4R / 1.5R / 4R. High Win-Rate: 0.5R / 2R / 5R. Balanced Pro: 1R / 3R / 5R, the largest profit per trade on gold 1H and above with about 61% winners. The smaller the first target, the higher the win rate and the lower the profit per trade: read Net R and PF in the panel.")
swingLook   = input.int(10, "Stop: swing lookback · buffer×ATR", minval = 2, group = G_RISK, inline = "sl")
slBuf       = input.float(0.25, "", minval = 0, step = 0.05, group = G_RISK, inline = "sl")
slMinAtr    = input.float(0.8, "Stop distance: min×ATR · max×ATR", minval = 0.1, step = 0.1, group = G_RISK, inline = "sl2")
slMaxAtr    = input.float(3.5, "", minval = 0.2, step = 0.1, group = G_RISK, inline = "sl2")
cTp1        = input.float(1.0, "Custom TP1 (R) · close %", minval = 0.1, step = 0.1, group = G_RISK, inline = "c1")
cW1         = input.float(50, "", minval = 0, maxval = 100, group = G_RISK, inline = "c1")
cTp2        = input.float(3.0, "Custom TP2 (R) · close %", minval = 0.1, step = 0.1, group = G_RISK, inline = "c2")
cW2         = input.float(25, "", minval = 0, maxval = 100, group = G_RISK, inline = "c2")
cTp3        = input.float(5.0, "Custom TP3 (R)", minval = 0.1, step = 0.1, group = G_RISK, inline = "c3")
cTrail      = input.bool(false, "Custom: chandelier trail after TP1", group = G_RISK)
cBe         = input.bool(true, "Custom: move stop to breakeven after TP1", group = G_RISK)
closeStop   = input.bool(true, "Fill a stop raised on the same bar when that bar closes through it", group = G_RISK, tooltip = "When a bar reaches TP1 (or TP2) and then closes at or beyond the stop that this fill has just moved to breakeven (or to TP1), price must have crossed that stop after the fill, so the remainder exits at the stop on this bar. Off: the raised stop is first tested at the next open.")
intrabar    = input.bool(true, "Replay stops and targets on intrabar data", group = G_RISK, tooltip = "A chart bar cannot tell whether its low came before or after its high; with a small first target and a breakeven stop that order decides most trades. When on, each managed bar is replayed on lower-timeframe bars (1D and above: 60 minutes, 4H: 15 minutes, 1H: 5 minutes, below: 1 minute) wherever TradingView provides them; older bars fall back to the chart bar. The panel shows how much of the simulation was replayed. Limit-order fills are still decided on the chart bar.")
chLen       = input.int(22, "Chandelier: length · ×ATR", minval = 2, group = G_RISK, inline = "ch")
chMult      = input.float(3.0, "", minval = 0.5, step = 0.1, group = G_RISK, inline = "ch")
maxBars     = input.int(0, "Time exit after N bars (0 = off)", minval = 0, group = G_RISK)
smallGuard  = input.bool(true, "Cost guard (charts below 1H) · max cost % of risk", group = G_RISK, inline = "cg", tooltip = "Skips signals whose stop is so tight that the estimated round-trip cost exceeds this share of the risk.")
cgMaxPct    = input.float(7.0, "", minval = 1, step = 0.5, group = G_RISK, inline = "cg")

showSig     = input.bool(true, "BUY / SELL labels", group = G_VIS)
sigDetail   = input.string("Signal only", "Label text", options = ["Signal only", "Signal + setup"], group = G_VIS)
showLevels  = input.bool(true, "Entry / stop / target lines", group = G_VIS)
showBoxes   = input.bool(true, "Risk / reward zones", group = G_VIS)
showTpTags  = input.bool(true, "✅ target and exit tags", group = G_VIS)
showLive    = input.bool(true, "Live price labels for the open trade", group = G_VIS)
keepTrades  = input.int(10, "Keep last N closed trades on the chart", minval = 1, maxval = 40, group = G_VIS)
projBars    = input.int(5, "Project the open trade N bars ahead", minval = 1, maxval = 50, group = G_VIS)
dimClosed   = input.bool(false, "Fade closed trades", group = G_VIS)
entryCol    = input.color(#2196f3, "Colors: entry · stop · targets", group = G_VIS, inline = "tc")
slCol       = input.color(#f23645, "", group = G_VIS, inline = "tc")
tpCol       = input.color(#22ab94, "", group = G_VIS, inline = "tc")
buyCol      = input.color(#089981, "Colors: BUY · SELL labels", group = G_VIS, inline = "lc")
sellCol     = input.color(#e0434f, "", group = G_VIS, inline = "lc")

showEma     = input.bool(true,  "EMA 21 / 55 / 200 + trend cloud", group = G_STR)
showSt      = input.bool(false, "SuperTrend line", group = G_STR)
colorBars   = input.bool(false, "Color bars by confluence", group = G_STR)
showSess    = input.bool(false, "Shade the active session", group = G_STR)
showChan    = input.bool(true, "Linear-regression channel · length · deviation", group = G_STR, inline = "ch1")
chanLen     = input.int(100, "", minval = 20, maxval = 900, group = G_STR, inline = "ch1")
chanDev     = input.float(2.0, "", minval = 0.5, step = 0.1, group = G_STR, inline = "ch1")
showTl      = input.bool(true, "Pivot trendlines · pivot strength", group = G_STR, inline = "tl")
pivLen      = input.int(10, "", minval = 2, maxval = 50, group = G_STR, inline = "tl")
showZones   = input.bool(true, "Support / resistance zones · per side", group = G_STR, inline = "z")
zoneCount   = input.int(3, "", minval = 1, maxval = 10, group = G_STR, inline = "z")
bullCol     = input.color(#00c08b, "Colors: bull · bear · neutral", group = G_STR, inline = "col")
bearCol     = input.color(#ff4d6d, "", group = G_STR, inline = "col")
neutCol     = input.color(#8a8f98, "", group = G_STR, inline = "col")

showSesBox  = input.bool(true, "Session boxes: Asia / London / New York", group = G_SES, tooltip = "Display only: the boxes mark each session's high and low and never change signals or statistics. Each session uses its own city's clock, so daylight-saving changes are handled. Shown on charts of 1H and below.")
sesDays     = input.int(5, "Keep last N days", minval = 1, maxval = 30, group = G_SES)
asiaSesIn   = input.session("0900-1800", "Asia (Tokyo time)", group = G_SES, inline = "as")
asiaCol     = input.color(#9c27b0, "", group = G_SES, inline = "as")
ldnSesIn    = input.session("0800-1700", "London (London time)", group = G_SES, inline = "ld")
ldnCol      = input.color(#2962ff, "", group = G_SES, inline = "ld")
nySesIn     = input.session("0800-1700", "New York (New York time)", group = G_SES, inline = "ny")
nyCol       = input.color(#ff9800, "", group = G_SES, inline = "ny")
sesFill     = input.int(90, "Box transparency", minval = 50, maxval = 100, group = G_SES)
showAsiaLv  = input.bool(true, "Extend the Asian high / low until the New York close", group = G_SES)

showPanel   = input.bool(true, "Show performance panel", group = G_PNL)
showSetRows = input.bool(false, "Per-setup scoreboard rows", group = G_PNL)
panelPos    = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = G_PNL)
panelSize   = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_PNL)

costMode    = input.string("Auto", "Round-trip cost for stats · custom %", options = ["Auto", "Custom"], group = G_SIZE, inline = "cost", tooltip = "Auto: gold 0.01% (≈ $0.40/oz at $4,000; raw-account brokers quote ≈ $0.15/oz spread + commission), 0.10% crypto, 0.06% silver/platinum/copper, 0.03% otherwise. Subtracted from every trade's R. Set Custom to your broker's real spread + commission.")
costCustom  = input.float(0.05, "", minval = 0, step = 0.01, group = G_SIZE, inline = "cost")
acct        = input.float(10000, "Account size · risk %", minval = 0, group = G_SIZE, inline = "acc")
riskPct     = input.float(1.0, "", minval = 0.01, step = 0.1, group = G_SIZE, inline = "acc")

// ───────────────────────────── Helpers ─────────────────────────────
if barstate.isfirst and not chart.is_standard
    runtime.error("APEX Fusion needs a standard candle/bar/line chart. Heikin Ashi, Renko and other synthetic charts would make signals and statistics unreproducible.")
if barstate.isfirst
    if slMinAtr > slMaxAtr
        runtime.error("Stop distance min ATR must be less than or equal to max ATR.")
    if profileIn == PROF_CUS
        if not (cTp1 < cTp2 and cTp2 < cTp3)
            runtime.error("Custom targets must satisfy TP1 < TP2 < TP3.")
        if cW1 + cW2 > 100
            runtime.error("Custom TP1 and TP2 close percentages must total at most 100%.")
isAr = lang == "العربية"
tr(string en, string ar) => isAr ? ar : en
fmt(float v) => str.tostring(v, format.mintick)
fmtR(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "#.##") + "R"
pct(float v) => str.tostring(v * 100, "#.#") + "%"

// Gold/silver tokens and perpetuals (XAUUSDT, PAXG, XAUT, XAGUSDT) are metals for cost, session and opening range.
bool isMetalTicker = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "XAG") or str.contains(syminfo.ticker, "PAXG") or str.contains(syminfo.ticker, "GOLD") or str.contains(syminfo.ticker, "SILVER")
// Crypto pairs are typed "crypto", "spot" (exchange spot pairs) or "swap" (perpetuals) depending on the symbol.
bool isCryptoSym = (syminfo.type == "crypto" or syminfo.type == "spot" or syminfo.type == "swap") and not isMetalTicker
bool isStockSym = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr" or syminfo.type == "index"
string assetClass = assetIn == "Auto" ? (isCryptoSym ? "crypto" : isStockSym ? "stock" : "metal") : assetIn == "Crypto" ? "crypto" : assetIn == "Stocks / Indices" ? "stock" : "metal"

autoHtf() =>
    int s = timeframe.in_seconds()
    s <= 300 and not ltfPack ? "60" : s <= 3600 ? "240" : s <= 14400 ? "D" : s <= 86400 ? "W" : "M"
autoAnchor() =>
    int s = timeframe.in_seconds()
    s <= 3600 ? "D" : s <= 14400 ? "W" : "M"

string htfRaw = htfMode == "Auto" ? autoHtf() : htfCustom
string htf = timeframe.in_seconds(htfRaw) < timeframe.in_seconds() ? timeframe.period : htfRaw
string anchorRaw = anchorMode == "Auto" ? autoAnchor() : anchorCustom
string anchorTf = timeframe.in_seconds(anchorRaw) < timeframe.in_seconds() ? timeframe.period : anchorRaw

// Trend of a requested timeframe: +1 when close > EMA and SuperTrend up, -1 when both down.
htfTrendCalc(int emaLen) =>
    [_, d] = ta.supertrend(3.0, 10)
    e = ta.ema(close, emaLen)
    na(e) or na(d) ? 0 : close > e and d < 0 ? 1 : close < e and d > 0 ? -1 : 0

// Constant-length requests (as in APEX): intraday HTF uses EMA50, Daily or higher uses EMA21.
bool htfUse21 = htfMode == "Auto" ? timeframe.in_seconds(htf) >= timeframe.in_seconds("D") : timeframe.in_seconds(htf) >= timeframe.in_seconds("1W")
int htfTrend50 = request.security(syminfo.tickerid, htf, htfTrendCalc(50)[1], lookahead = barmerge.lookahead_on)
int htfTrend21 = request.security(syminfo.tickerid, htf, htfTrendCalc(21)[1], lookahead = barmerge.lookahead_on)
int htfTrend = nz(htfUse21 ? htfTrend21 : htfTrend50)
int anchorTrend = nz(request.security(syminfo.tickerid, anchorTf, htfTrendCalc(21)[1], lookahead = barmerge.lookahead_on))

// ───────────────────────────── Core series ─────────────────────────────
atr        = ta.atr(14)
ema9       = ta.ema(close, 9)
ema21      = ta.ema(close, 21)
ema50      = ta.ema(close, 50)
ema55      = ta.ema(close, 55)
ema200     = ta.ema(close, 200)
[stLine, stDir] = ta.supertrend(stFactor, stLen)
[diP, diM, adx] = ta.dmi(14, 14)
rsi14      = ta.rsi(close, 14)
float volMa = ta.sma(volume, 20)
bool volOk = volMult <= 0 or na(volume) or na(volMa) or volume >= volMa * volMult
// Session VWAP built by hand: ta.vwap can stop the script on symbols whose vendor provides no volume.
var float vwCpv = 0.0
var float vwCv = 0.0
if timeframe.change("D")
    vwCpv := 0.0
    vwCv := 0.0
vwCpv += hlc3 * nz(volume)
vwCv += nz(volume)
float vwapV = vwCv > 0 ? vwCpv / vwCv : na
bool bullBar = close > open
bool bearBar = close < open
bool ready = not na(atr) and atr > 0

scoreOf(int d) =>
    int s = 0
    s += htfTrend == d ? 1 : 0
    s += (close - ema200) * d > 0 ? 1 : 0
    s += (ema21 - ema55) * d > 0 ? 1 : 0
    s += adx > adxMin ? 1 : 0
    s += adx > adx[3] and adx > 18 ? 1 : 0
    s += (diP - diM) * d > 0 ? 1 : 0
    s += (rsi14 - 50) * d > 0 ? 1 : 0
    s

int scoreL = scoreOf(1)
int scoreS = scoreOf(-1)

// ───────────────────────────── Setups (raw triggers) ─────────────────────────────
// APEX: Donchian breakout
float donHi = ta.highest(high, donLen)[1]
float donLo = ta.lowest(low, donLen)[1]
bool sBrkL = close > donHi and close[1] <= donHi[1]
bool sBrkS = close < donLo and close[1] >= donLo[1]
// APEX: SuperTrend flip
bool sFlipL = stDir < 0 and stDir[1] > 0
bool sFlipS = stDir > 0 and stDir[1] < 0
// APEX: trend pullback resume
bool touchUp = ta.lowest(low - ema21, 5) <= 0
bool touchDn = ta.highest(high - ema21, 5) >= 0
bool sPbL = stDir < 0 and touchUp and close > high[1] and close > ema21 and bullBar
bool sPbS = stDir > 0 and touchDn and close < low[1] and close < ema21 and bearBar
// GBB: EMA pullback
bool trendUpG = ema21 > ema50 and ema50 > ema50[3]
bool trendDnG = ema21 < ema50 and ema50 < ema50[3]
bool touchedUpG = ta.barssince(low <= ema21) <= emaWindow
bool touchedDnG = ta.barssince(high >= ema21) <= emaWindow
bool sEmaL = trendUpG and touchedUpG and close > ema9 and bullBar and close > high[1] and volOk
bool sEmaS = trendDnG and touchedDnG and close < ema9 and bearBar and close < low[1] and volOk
// GBB: VWAP reclaim
var int belowRun = 0
var int aboveRun = 0
bool vwapCrossUp = ta.crossover(close, vwapV)
bool vwapCrossDn = ta.crossunder(close, vwapV)
if not na(vwapV)
    belowRun := close < vwapV ? belowRun + 1 : 0
    aboveRun := close > vwapV ? aboveRun + 1 : 0
bool sVwapL = not na(vwapV) and vwapCrossUp and nz(belowRun[1]) >= vwapAway and volOk
bool sVwapS = not na(vwapV) and vwapCrossDn and nz(aboveRun[1]) >= vwapAway and volOk
// GBB: liquidity sweep
float swLo = ta.lowest(low, sweepLen)[1]
float swHi = ta.highest(high, sweepLen)[1]
bool sSweepL = not na(swLo) and low < swLo and close > swLo and bullBar and (close - low) > (high - close) and volOk
bool sSweepS = not na(swHi) and high > swHi and close < swHi and bearBar and (high - close) > (close - low) and volOk

// GBB: break and retest of a confirmed swing
float phV = ta.pivothigh(high, pvLen, pvLen)
float plV = ta.pivotlow(low, pvLen, pvLen)
var float brtHiLvl = na
var bool  brtHiBrk = false
var int   brtHiBar = na
var float brtHiPend = na
var float brtLoLvl = na
var bool  brtLoBrk = false
var int   brtLoBar = na
var float brtLoPend = na
brtBusy(bool brk, int brkBar) =>
    brk and not na(brkBar) and bar_index - brkBar <= brtWindow
if not na(phV)
    if brtBusy(brtHiBrk, brtHiBar)
        brtHiPend := phV
    else
        brtHiLvl := phV
        brtHiBrk := false
        brtHiPend := na
if not na(plV)
    if brtBusy(brtLoBrk, brtLoBar)
        brtLoPend := plV
    else
        brtLoLvl := plV
        brtLoBrk := false
        brtLoPend := na
if not na(brtHiLvl) and not brtHiBrk and close > brtHiLvl
    brtHiBrk := true
    brtHiBar := bar_index
if not na(brtLoLvl) and not brtLoBrk and close < brtLoLvl
    brtLoBrk := true
    brtLoBar := bar_index
bool brtLiveL = brtBusy(brtHiBrk, brtHiBar) and bar_index > brtHiBar
bool brtLiveS = brtBusy(brtLoBrk, brtLoBar) and bar_index > brtLoBar
bool sBrtL = brtLiveL and ready and low <= brtHiLvl + atr * brtTol and close > brtHiLvl and bullBar
bool sBrtS = brtLiveS and ready and high >= brtLoLvl - atr * brtTol and close < brtLoLvl and bearBar
if sBrtL
    brtHiBrk := false
if sBrtS
    brtLoBrk := false
if not brtBusy(brtHiBrk, brtHiBar) and not na(brtHiPend)
    brtHiLvl := brtHiPend
    brtHiBrk := false
    brtHiPend := na
if not brtBusy(brtLoBrk, brtLoBar) and not na(brtLoPend)
    brtLoLvl := brtLoPend
    brtLoBrk := false
    brtLoPend := na

// GBB: RSI divergence (confirms pvLen bars after the pivot)
var float lastPlP = na
var float lastPlR = na
var int   lastPlB = na
var float lastPhP = na
var float lastPhR = na
var int   lastPhB = na
bool sDivL = false
bool sDivS = false
float rsiAtPivot = rsi14[pvLen]
if not na(plV)
    if not na(lastPlP) and bar_index - lastPlB <= divGap
        sDivL := plV < lastPlP and rsiAtPivot > lastPlR
    lastPlP := plV
    lastPlR := rsiAtPivot
    lastPlB := bar_index
if not na(phV)
    if not na(lastPhP) and bar_index - lastPhB <= divGap
        sDivS := phV > lastPhP and rsiAtPivot < lastPhR
    lastPhP := phV
    lastPhR := rsiAtPivot
    lastPhB := bar_index

// GBB: opening-range break (one break per session)
string orSess = orbMode == "Custom" ? orSessIn : assetClass == "crypto" ? "0000-2300" : "0930-1600"
string orTz = orbMode == "Custom" ? orTzIn : assetClass == "crypto" ? "UTC" : "America/New_York"
bool inOrSess = not na(time(timeframe.period, orSess, orTz))
bool newOrSess = inOrSess and not inOrSess[1]
var float orH = na
var float orL = na
var bool  orDone = false
var bool  orFired = false
var int   orStart = na
if newOrSess
    orH := high
    orL := low
    orDone := false
    orFired := false
    orStart := time
else if inOrSess and not orDone
    if not na(orStart) and (time - orStart) >= orMin * 60000
        orDone := true
    else
        orH := math.max(nz(orH, high), high)
        orL := math.min(nz(orL, low), low)
bool sOrbL = inOrSess and orDone and not orFired and not na(orH) and close > orH
bool sOrbS = inOrSess and orDone and not orFired and not na(orL) and close < orL
if useOrb and barstate.isconfirmed and (sOrbL or sOrbS)
    orFired := true

// APEX: zone rebound (support) / rejection (resistance) state machine
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)
type RZone
    float top
    float bottom
    int   bornBar
    int   state = 0
    int   touchBar = na
    float touchHigh = na
    float touchLow = na
var array<RZone> rebSup = array.new<RZone>()
var array<RZone> rebRes = array.new<RZone>()
var int lastRebL = na
var int lastRebS = na

rebStep(array<RZone> zones, int side, int lastEvt) =>
    bool ev = false
    int newLast = lastEvt
    if zones.size() > 0
        for i = zones.size() - 1 to 0
            RZone z = zones.get(i)
            bool broken = side == 1 ? close < z.bottom : close > z.top
            if broken
                z.state := 4
            else if z.state == 0
                if z.bornBar < bar_index and low <= z.top and high >= z.bottom
                    z.state := 1
                    z.touchBar := bar_index
                    z.touchHigh := high
                    z.touchLow := low
            else if z.state == 1
                int age = bar_index - z.touchBar
                if age > bounceWindow
                    z.state := 2
                else if age >= 1 and (side == 1 ? (close > open and close > z.touchHigh and close > z.top) : (close < open and close < z.touchLow and close < z.bottom))
                    if not ev and (na(newLast) or bar_index - newLast >= 5)
                        z.state := 3
                        ev := true
                        newLast := bar_index
            else if z.state == 2
                if side == 1 ? close > z.top + 0.5 * atr : close < z.bottom - 0.5 * atr
                    z.state := 0
        if ev
            for z in zones
                if z.state == 1
                    z.state := 2
    [ev, newLast]

bool sRebL = false
bool sRebS = false
if barstate.isconfirmed and useReb
    [evL, nlL] = rebStep(rebSup, 1, lastRebL)
    [evS, nlS] = rebStep(rebRes, -1, lastRebS)
    sRebL := evL
    sRebS := evS
    lastRebL := nlL
    lastRebS := nlS
    if not na(pl) and ready
        rebSup.push(RZone.new(pl + 0.15 * atr, pl - 0.15 * atr, bar_index))
        while rebSup.size() > zoneCount
            rebSup.shift()
    if not na(ph) and ready
        rebRes.push(RZone.new(ph + 0.15 * atr, ph - 0.15 * atr, bar_index))
        while rebRes.size() > zoneCount
            rebRes.shift()

// ───────────────────────────── Fusion gate ─────────────────────────────
bool inSessRaw = not na(time(timeframe.period, sessStr, sessTz))
bool sessOn = sessIn == "On" or (sessIn == "Auto" and assetClass != "crypto")
bool sessApplies = sessOn and timeframe.isintraday and timeframe.in_seconds() < 14400
bool inTradeSess = not sessApplies or inSessRaw

bool baseL = (not useAnchor or anchorTrend == 1) and inTradeSess
bool baseS = (not useAnchor or anchorTrend == -1) and inTradeSess
bool ltfOn = ltfPack and timeframe.isintraday and timeframe.in_seconds() < 3600
bool usePullback = ltfOn
bool okBar = not ltfOn or (high - low) <= maxBarAtr * atr
bool trendGateL = baseL and scoreL >= minScore and (not useHtfGate or htfTrend == 1) and okBar
bool trendGateS = baseS and scoreS >= minScore and (not useHtfGate or htfTrend == -1) and okBar
bool revGateL = baseL and htfTrend != -1
bool revGateS = baseS and htfTrend != 1

// Priority when several setups fire on one bar (label only; one trade either way).
string setupL = not ready ? "" : useBrt and sBrtL and trendGateL ? "B&R" : useOrb and sOrbL and trendGateL ? "ORB" : useBrk and sBrkL and trendGateL ? "BRK" : useEma and sEmaL and trendGateL ? "EMA" : usePb and sPbL and trendGateL ? "PB" : useFlip and sFlipL and trendGateL ? "FLIP" : useVwap and sVwapL and trendGateL ? "VWAP" : useSweep and sSweepL and revGateL ? "SWEEP" : useDiv and sDivL and revGateL ? "DIV" : useReb and sRebL and revGateL ? "REB" : ""
string setupS = not ready ? "" : useBrt and sBrtS and trendGateS ? "B&R" : useOrb and sOrbS and trendGateS ? "ORB" : useBrk and sBrkS and trendGateS ? "BRK" : useEma and sEmaS and trendGateS ? "EMA" : usePb and sPbS and trendGateS ? "PB" : useFlip and sFlipS and trendGateS ? "FLIP" : useVwap and sVwapS and trendGateS ? "VWAP" : useSweep and sSweepS and revGateS ? "SWEEP" : useDiv and sDivS and revGateS ? "DIV" : useReb and sRebS and revGateS ? "REB" : ""
bool rawL = setupL != "" and dirMode != "Short only"
bool rawS = setupS != "" and dirMode != "Long only" and not rawL

// Stops: last swing beyond a buffer, clamped to [min, max] × ATR (APEX)
float slDistL = math.min(math.max(close - (ta.lowest(low, swingLook) - slBuf * atr), slMinAtr * atr), slMaxAtr * atr)
float slDistS = math.min(math.max((ta.highest(high, swingLook) + slBuf * atr) - close, slMinAtr * atr), slMaxAtr * atr)

bool hiCostMetal = str.contains(syminfo.ticker, "XAG") or str.contains(syminfo.ticker, "SILVER") or str.contains(syminfo.ticker, "XPT") or str.contains(syminfo.ticker, "XCU")
bool isGold = assetClass == "metal" and (str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "PAXG") or str.contains(syminfo.ticker, "GOLD") or syminfo.root == "GC" or syminfo.root == "MGC")
float costPct = costMode == "Auto" ? (assetClass == "crypto" ? 0.10 : hiCostMetal ? 0.06 : isGold ? 0.01 : 0.03) : costCustom
bool smallTf = timeframe.in_seconds() < 3600
float cgMinDist = costPct / 100 * close / (cgMaxPct / 100)
bool cgOkL = not (smallGuard and smallTf) or slDistL >= cgMinDist
bool cgOkS = not (smallGuard and smallTf) or slDistS >= cgMinDist

bool warm = bar_index >= 250
bool floorOkL = not ltfOn or slDistL >= minStopPct / 100 * close
bool floorOkS = not ltfOn or slDistS >= minStopPct / 100 * close
bool longSig  = barstate.isconfirmed and warm and rawL and ready and cgOkL and floorOkL
bool shortSig = barstate.isconfirmed and warm and rawS and ready and cgOkS and floorOkS
float chandL = ta.highest(high, chLen) - chMult * atr
float chandS = ta.lowest(low, chLen) + chMult * atr
float chandL1 = chandL[1]
float chandS1 = chandS[1]

// Management profile
string profile = profileIn == PROF_AUTO ? (timeframe.in_seconds() >= 3600 ? PROF_HW : ltfPack ? PROF_SNP : PROF_BAL) : profileIn
float k1 = profile == PROF_SHD ? 0.05 : profile == PROF_SNP ? 0.2 : profile == PROF_MW ? 0.4 : profile == PROF_BAL ? 1.0 : profile == PROF_HW ? 0.5 : profile == PROF_HP ? 0.3 : profile == PROF_RUN ? 1.0 : cTp1
float k2 = profile == PROF_SHD ? 1.5 : profile == PROF_SNP ? 1.5 : profile == PROF_MW ? 1.5 : profile == PROF_BAL ? 3.0 : profile == PROF_HW ? 2.0 : profile == PROF_HP ? 1.5 : profile == PROF_RUN ? 2.0 : cTp2
float k3 = profile == PROF_SHD ? 4.0 : profile == PROF_SNP ? 4.0 : profile == PROF_MW ? 4.0 : profile == PROF_BAL ? 5.0 : profile == PROF_HW ? 5.0 : profile == PROF_HP ? 4.0 : profile == PROF_RUN ? 8.0 : cTp3
float w1 = profile == PROF_SHD ? 0.50 : profile == PROF_SNP ? 0.60 : profile == PROF_MW ? 0.60 : profile == PROF_BAL ? 0.50 : profile == PROF_HW ? 0.50 : profile == PROF_HP ? 0.50 : profile == PROF_RUN ? 0.33 : cW1 / 100
float w2 = profile == PROF_SHD ? 0.25 : profile == PROF_SNP ? 0.20 : profile == PROF_MW ? 0.20 : profile == PROF_BAL ? 0.25 : profile == PROF_HW ? 0.25 : profile == PROF_HP ? 0.25 : profile == PROF_RUN ? 0.33 : cW2 / 100
bool trailOn = profile == PROF_HP or profile == PROF_RUN or (profile == PROF_CUS and cTrail)
int  trailFrom = profile == PROF_RUN ? 2 : 1
bool beOn = profile == PROF_SHD or profile == PROF_SNP or profile == PROF_MW or profile == PROF_BAL or profile == PROF_HW or profile == PROF_HP or (profile == PROF_CUS and cBe)

// ───────────────────────────── Trade model ─────────────────────────────
type Trade
    int    dir
    int    entryBar
    string setup
    int    score
    float  entry
    float  sl
    float  sl0
    float  risk
    float  tp1
    float  tp2
    float  tp3
    bool   hit1 = false
    bool   hit2 = false
    bool   hit3 = false
    float  realized = 0.0
    float  openW = 1.0
    line   lnEntry
    line   lnSl
    line   lnTp1
    line   lnTp2
    line   lnTp3
    box    bxRisk
    box    bxReward
    label  lbSig
    label  lbTp1
    label  lbTp2
    label  lbTp3
    label  lbOut

type Stats
    int   n      = 0
    int   tp1    = 0
    int   tp2    = 0
    int   tp3    = 0
    int   fullSl = 0
    int   win    = 0
    float gross  = 0.0
    float loss   = 0.0
    float net    = 0.0
    float peak   = 0.0
    float maxDd  = 0.0
    int   nL     = 0
    float netL   = 0.0
    int   nS     = 0
    float netS   = 0.0
    int   firstTime = na
    float lastPx = na
    int   lastBar = na

var Trade cur = na
var Stats st = Stats.new()
var array<Trade> closedTrades = array.new<Trade>()
const int N_SETUPS = 10
var array<string> setupNames = array.from("B&R", "ORB", "BRK", "EMA", "PB", "FLIP", "VWAP", "SWEEP", "DIV", "REB")
var array<int>   setN   = array.new<int>(N_SETUPS, 0)
var array<int>   setWin = array.new<int>(N_SETUPS, 0)
var array<float> setR   = array.new<float>(N_SETUPS, 0.0)

deleteTradeVisuals(Trade t) =>
    line.delete(t.lnEntry)
    line.delete(t.lnSl)
    line.delete(t.lnTp1)
    line.delete(t.lnTp2)
    line.delete(t.lnTp3)
    box.delete(t.bxRisk)
    box.delete(t.bxReward)
    label.delete(t.lbSig)
    label.delete(t.lbTp1)
    label.delete(t.lbTp2)
    label.delete(t.lbTp3)
    label.delete(t.lbOut)

extendTrade(Trade t, int x) =>
    if not na(t.lnEntry)
        t.lnEntry.set_x2(x)
        t.lnSl.set_x2(x)
        t.lnTp1.set_x2(x)
        t.lnTp2.set_x2(x)
        t.lnTp3.set_x2(x)
    if not na(t.bxRisk)
        t.bxRisk.set_right(x)
        t.bxReward.set_right(x)
    if not na(t.lbTp1)
        t.lbTp1.set_x(x)
    if not na(t.lbTp2)
        t.lbTp2.set_x(x)
    if not na(t.lbTp3)
        t.lbTp3.set_x(x)

tpTag(Trade t, int k) =>
    float px = k == 1 ? t.tp1 : k == 2 ? t.tp2 : t.tp3
    line ln = k == 1 ? t.lnTp1 : k == 2 ? t.lnTp2 : t.lnTp3
    if not na(ln)
        ln.set_width(2)
    if showTpTags
        label lb = label.new(bar_index, px, "✅ TP" + str.tostring(k), style = label.style_label_left, color = tpCol, textcolor = color.white, size = size.small, tooltip = "TP" + str.tostring(k) + " " + fmt(px))
        if k == 1
            t.lbTp1 := lb
        else if k == 2
            t.lbTp2 := lb
        else
            t.lbTp3 := lb

applyTp1(Trade t) =>
    t.hit1 := true
    float w = math.min(w1, t.openW)
    t.realized += w * k1
    t.openW -= w
    if beOn
        t.sl := t.dir == 1 ? math.max(t.sl, t.entry) : math.min(t.sl, t.entry)
    tpTag(t, 1)

applyTp2(Trade t) =>
    t.hit2 := true
    float w = math.min(w2, t.openW)
    t.realized += w * k2
    t.openW -= w
    t.sl := t.dir == 1 ? math.max(t.sl, t.tp1) : math.min(t.sl, t.tp1)
    tpTag(t, 2)

applyTp3(Trade t) =>
    t.hit3 := true
    t.realized += t.openW * k3
    t.openW := 0.0
    tpTag(t, 3)

applyTrail(Trade t) =>
    if trailOn and (trailFrom == 1 ? t.hit1 : t.hit2)
        float tv = t.dir == 1 ? chandL1 : chandS1
        if not na(tv)
            t.sl := t.dir == 1 ? math.max(t.sl, tv) : math.min(t.sl, tv)

// Stop telemetry is based on the active stop and the remaining position.
activeStopReason(Trade t) =>
    bool stillInitial = t.sl == t.sl0
    bool fullPosition = t.openW >= 1.0 - 1e-9
    stillInitial ? (fullPosition ? "SL" : "Remaining SL") : "BE/Trail"

setupId(string s) =>
    int id = -1
    for i = 0 to N_SETUPS - 1
        if setupNames.get(i) == s
            id := i
    id

closeTrade(Trade t, float px, string reason) =>
    t.realized += t.openW * (px - t.entry) * t.dir / t.risk
    t.openW := 0.0
    float cR = costPct / 100 * t.entry / t.risk
    float R = t.realized - cR
    st.n += 1
    st.tp1 += t.hit1 ? 1 : 0
    st.tp2 += t.hit2 ? 1 : 0
    st.tp3 += t.hit3 ? 1 : 0
    st.fullSl += reason == "SL" ? 1 : 0
    st.win += R > 0 ? 1 : 0
    st.gross += R > 0 ? R : 0
    st.loss += R < 0 ? -R : 0
    st.net += R
    if na(st.firstTime)
        st.firstTime := time
    st.lastPx := px
    st.lastBar := bar_index
    if t.dir == 1
        st.nL += 1
        st.netL += R
    else
        st.nS += 1
        st.netS += R
    st.peak := math.max(st.peak, st.net)
    st.maxDd := math.max(st.maxDd, st.peak - st.net)
    int sid = setupId(t.setup)
    if sid >= 0
        setN.set(sid, setN.get(sid) + 1)
        setWin.set(sid, setWin.get(sid) + (R > 0 ? 1 : 0))
        setR.set(sid, setR.get(sid) + R)
    extendTrade(t, bar_index)
    if showTpTags and reason != "TP" and reason != "TP3"
        string txt = reason == "SL" or reason == "Remaining SL" ? "❌ SL" : reason == "BE/Trail" ? (t.sl == t.entry ? "BE" : "TRAIL") : reason == "Time" ? "⏱ EXIT" : "⇄ EXIT"
        color c = R > 0 ? tpCol : R < 0 ? slCol : neutCol
        t.lbOut := label.new(bar_index, px, txt, style = label.style_label_left, color = c, textcolor = color.white, size = size.small, tooltip = reason + " @ " + fmt(px) + " | " + fmtR(R))
    if dimClosed
        if not na(t.bxRisk)
            t.bxRisk.set_bgcolor(color.new(slCol, 93))
            t.bxReward.set_bgcolor(color.new(tpCol, 94))
        if not na(t.lnEntry)
            t.lnEntry.set_color(color.new(entryCol, 60))
            t.lnSl.set_color(color.new(slCol, 60))
            t.lnTp1.set_color(color.new(tpCol, t.hit1 ? 30 : 70))
            t.lnTp2.set_color(color.new(tpCol, t.hit2 ? 30 : 70))
            t.lnTp3.set_color(color.new(tpCol, t.hit3 ? 30 : na(t.tp3) ? 100 : 70))
    closedTrades.push(t)
    while closedTrades.size() > keepTrades
        deleteTradeVisuals(closedTrades.shift())
    R

signalTip(int d, string setup, int score, float e, float stopPx) =>
    float dist = math.abs(e - stopPx)
    float qty = dist > 0 ? acct * riskPct / 100 / (dist * syminfo.pointvalue) : na
    float t3 = e + d * k3 * dist
    (d == 1 ? "BUY" : "SELL") + " | " + tr("Setup: ", "النموذج: ") + setup + " | " + tr("Score ", "التوافق ") + str.tostring(score) + "/7\n" + tr("Entry ", "الدخول ") + fmt(e) + "\n" + tr("Stop ", "الوقف ") + fmt(stopPx) + "\nTP1 " + fmt(e + d * k1 * dist) + " (" + str.tostring(k1) + "R)\nTP2 " + fmt(e + d * k2 * dist) + " (" + str.tostring(k2) + "R)\nTP3 " + (t3 > syminfo.mintick ? fmt(t3) : "—") + " (" + str.tostring(k3) + "R)\n" + tr("Size @", "الحجم @") + str.tostring(riskPct) + "%: " + str.tostring(qty, "#.####")

signalLabel(int d, string setup, int score, float e, float stopPx, string prefix) =>
    string txt = (d == 1 ? "BUY" : "SELL") + (sigDetail == "Signal + setup" ? " · " + setup : "")
    label.new(bar_index, stopPx, txt, style = d == 1 ? label.style_label_up : label.style_label_down, color = d == 1 ? buyCol : sellCol, textcolor = color.white, size = size.small, tooltip = prefix + signalTip(d, setup, score, e, stopPx))

// Opens a trade at entry price e with a structural stop; drawings start at bar x0.
openTradeAt(int d, string setup, int score, float e, float stopPx, int x0, label lbIn) =>
    float dist = (e - stopPx) * d
    float tp3 = e + d * k3 * dist
    // a far short target can fall at or below zero: leave TP3 empty and let the stop manage the runner
    Trade t = Trade.new(d, bar_index, setup, score, e, stopPx, stopPx, dist, e + d * k1 * dist, e + d * k2 * dist, tp3 > syminfo.mintick ? tp3 : na)
    float rewardEdge = na(t.tp3) ? t.tp2 : t.tp3
    int xr = bar_index + projBars
    if showBoxes
        t.bxRisk := box.new(x0, math.max(e, t.sl), xr, math.min(e, t.sl), border_color = color.new(slCol, 100), bgcolor = color.new(slCol, 84))
        t.bxReward := box.new(x0, math.max(e, rewardEdge), xr, math.min(e, rewardEdge), border_color = color.new(tpCol, 100), bgcolor = color.new(tpCol, 86))
    if showLevels
        t.lnTp1 := line.new(x0, t.tp1, xr, t.tp1, color = tpCol, width = 1)
        t.lnTp2 := line.new(x0, t.tp2, xr, t.tp2, color = tpCol, width = 1)
        t.lnTp3 := line.new(x0, rewardEdge, xr, rewardEdge, color = color.new(tpCol, na(t.tp3) ? 100 : 0), width = 1)
        t.lnSl := line.new(x0, t.sl, xr, t.sl, color = slCol, width = 2)
        t.lnEntry := line.new(x0, e, xr, e, color = entryCol, width = 2)
    if showSig
        if na(lbIn)
            t.lbSig := signalLabel(d, setup, score, e, stopPx, "")
        else
            t.lbSig := lbIn
            lbIn.set_tooltip(tr("Filled — ", "نُفّذ — ") + signalTip(d, setup, score, e, stopPx))
    t

// Pending pullback limit order (charts below 1H). It exists only while no trade is open.
type Pending
    int    dir
    int    bar
    float  limit
    float  stop
    string setup
    int    score
    label  lb
    line   ln

var Pending pend = na
var array<label> missedLabels = array.new<label>()

cancelPending(Pending p) =>
    line.delete(p.ln)
    if not na(p.lb)
        p.lb.set_color(color.new(neutCol, 40))
        p.lb.set_text(p.lb.get_text() + " ✗")
        p.lb.set_tooltip(tr("Limit entry not filled — no trade", "لم يُنفَّذ أمر الدخول المحدد — لا صفقة"))
        missedLabels.push(p.lb)
        while missedLabels.size() > keepTrades
            label.delete(missedLabels.shift())

// 1) Manage the open trade on bars AFTER the entry bar.
// Each managed chart bar is walked as a sequence of price segments: its intrabars when the replay is on and
// TradingView has them, otherwise the chart bar itself. Inside one segment: trail from the previous completed
// chart bar -> stop already through at the segment open -> targets marketable at the open -> stop inside the
// range (stop first) -> targets inside the range -> a stop raised by such a fill when the segment closes
// through it. A stop moved by a fill is live for every later segment of the same chart bar.
bool evTp1 = false
bool evTp2 = false
bool evTp3 = false
bool evSl  = false
bool evExit = false
float lastR = na
// Side of the trade that this bar's exit / target events belong to (a new trade may replace it below).
int evDir = 0
if not na(cur)
    evDir := cur.dir
// Intrabar prices of the chart bar. The arrays are empty (or na) when the bar is older than the intrabar
// history TradingView provides. With the replay off the request is made at the chart's own timeframe and unused.
string ibTf = not intrabar ? timeframe.period : timeframe.in_seconds() >= 86400 ? "60" : timeframe.in_seconds() >= 14400 ? "15" : timeframe.in_seconds() >= 3600 ? "5" : "1"
bool ibFiner = intrabar and timeframe.in_seconds(ibTf) < timeframe.in_seconds()
[ibO, ibH, ibL, ibC] = request.security_lower_tf(syminfo.tickerid, ibTf, [open, high, low, close], ignore_invalid_timeframe = true)
var int managedBars = 0
var int replayedBars = 0
if barstate.isconfirmed and not na(cur) and bar_index > cur.entryBar
    int d = cur.dir
    bool useIb = ibFiner and not na(ibH) and ibH.size() > 0
    int segCount = useIb ? ibH.size() : 1
    managedBars += 1
    replayedBars += useIb ? 1 : 0
    for seg = 0 to segCount - 1
        if na(cur)
            break
        float bo = useIb ? ibO.get(seg) : open
        float bh = useIb ? ibH.get(seg) : high
        float bl = useIb ? ibL.get(seg) : low
        float bc = useIb ? ibC.get(seg) : close
        applyTrail(cur)
        bool openingStopHit = d == 1 ? bo <= cur.sl : bo >= cur.sl
        if openingStopHit
            string reason = activeStopReason(cur)
            evSl := reason != "BE/Trail"
            evExit := reason == "BE/Trail"
            lastR := closeTrade(cur, bo, reason)
            cur := na
        else
            // Targets already marketable at the open fill at their limit prices.
            if not cur.hit1 and (d == 1 ? bo >= cur.tp1 : bo <= cur.tp1)
                applyTp1(cur)
                evTp1 := true
            if cur.openW > 1e-9 and cur.hit1 and not cur.hit2 and (d == 1 ? bo >= cur.tp2 : bo <= cur.tp2)
                applyTp2(cur)
                evTp2 := true
            if cur.openW <= 1e-9
                lastR := closeTrade(cur, cur.hit2 ? cur.tp2 : cur.tp1, "TP")
                cur := na
            if not na(cur) and cur.hit2 and not cur.hit3 and not na(cur.tp3) and (d == 1 ? bo >= cur.tp3 : bo <= cur.tp3)
                applyTp3(cur)
                evTp3 := true
                lastR := closeTrade(cur, cur.tp3, "TP3")
                cur := na
            if not na(cur)
                applyTrail(cur)
                bool stopHit = d == 1 ? bl <= cur.sl : bh >= cur.sl
                if stopHit
                    float px = (d == 1 and bo < cur.sl) or (d == -1 and bo > cur.sl) ? bo : cur.sl
                    string reason = activeStopReason(cur)
                    evSl := reason != "BE/Trail"
                    evExit := reason == "BE/Trail"
                    lastR := closeTrade(cur, px, reason)
                    cur := na
                else
                    if not cur.hit1 and (d == 1 ? bh >= cur.tp1 : bl <= cur.tp1)
                        applyTp1(cur)
                        evTp1 := true
                    if cur.openW > 1e-9 and cur.hit1 and not cur.hit2 and (d == 1 ? bh >= cur.tp2 : bl <= cur.tp2)
                        applyTp2(cur)
                        evTp2 := true
                    if cur.openW <= 1e-9
                        lastR := closeTrade(cur, cur.hit2 ? cur.tp2 : cur.tp1, "TP")
                        cur := na
                    if not na(cur) and cur.hit2 and not cur.hit3 and not na(cur.tp3) and (d == 1 ? bh >= cur.tp3 : bl <= cur.tp3)
                        applyTp3(cur)
                        evTp3 := true
                        lastR := closeTrade(cur, cur.tp3, "TP3")
                        cur := na
                    // The low was above the old stop, so the segment can only close at or through the stop if
                    // a fill inside it raised the stop (breakeven after TP1, TP1 lock after TP2). The close is
                    // the segment's last trade, so price crossed the new stop after that fill: exit there.
                    if closeStop and not na(cur) and (d == 1 ? bc <= cur.sl : bc >= cur.sl)
                        string reason = activeStopReason(cur)
                        evSl := reason != "BE/Trail"
                        evExit := reason == "BE/Trail"
                        lastR := closeTrade(cur, cur.sl, reason)
                        cur := na
    // Time exit: once per chart bar, at its close, when the trade survived the bar.
    if not na(cur) and maxBars > 0 and bar_index - cur.entryBar >= maxBars
        lastR := closeTrade(cur, close, "Time")
        evExit := true
        cur := na
    if not na(cur)
        extendTrade(cur, bar_index + projBars)

// 1b) Pending pullback limit order: fill, expire, or cancel (only while flat).
bool evFill = false
bool evCancel = false
float fillPx = na
float fillSl = na
int fillDir = 0
if barstate.isconfirmed and not na(pend)
    if not na(cur)
        cancelPending(pend)
        evCancel := true
        pend := na
    else if bar_index > pend.bar
        int pdir = pend.dir
        bool expired = bar_index - pend.bar > pbBars
        bool invalid = pdir == 1 ? open <= pend.stop : open >= pend.stop
        if expired or invalid
            cancelPending(pend)
            evCancel := true
            pend := na
        else if (pdir == 1 ? low <= pend.limit : high >= pend.limit)
            float fill = pdir == 1 ? math.min(open, pend.limit) : math.max(open, pend.limit)
            if (fill - pend.stop) * pdir > 0
                line.delete(pend.ln)
                cur := openTradeAt(pdir, pend.setup, pend.score, fill, pend.stop, pend.bar, pend.lb)
                evFill := true
                fillPx := fill
                fillSl := pend.stop
                fillDir := pdir
                evDir := pdir
                // Unknown order inside the fill bar: if it also reached the stop, count the stop.
                if (pdir == 1 ? low <= cur.sl : high >= cur.sl)
                    lastR := closeTrade(cur, cur.sl, "SL")
                    evSl := true
                    cur := na
            else
                cancelPending(pend)
                evCancel := true
            pend := na

// 2) New signals on bar close (an opposite signal reverses an open trade when enabled).
bool newLong  = false
bool newShort = false
if longSig and (na(cur) or (reverseOn and cur.dir == -1))
    if not na(cur)
        lastR := closeTrade(cur, close, "Reverse")
        evExit := true
        cur := na
    if usePullback
        if not na(pend)
            cancelPending(pend)
            evCancel := true
        float lim = close - pbFrac * slDistL
        float stp = close - slDistL
        label lb = showSig ? signalLabel(1, setupL, scoreL, lim, stp, tr("Limit entry — ", "دخول بأمر محدد — ")) : na
        line ln = showLevels ? line.new(bar_index, lim, bar_index + pbBars, lim, color = entryCol, style = line.style_dashed, width = 1) : na
        pend := Pending.new(1, bar_index, lim, stp, setupL, scoreL, lb, ln)
    else
        cur := openTradeAt(1, setupL, scoreL, close, close - slDistL, bar_index, na)
    newLong := true
else if shortSig and (na(cur) or (reverseOn and cur.dir == 1))
    if not na(cur)
        lastR := closeTrade(cur, close, "Reverse")
        evExit := true
        cur := na
    if usePullback
        if not na(pend)
            cancelPending(pend)
            evCancel := true
        float lim = close + pbFrac * slDistS
        float stp = close + slDistS
        label lb = showSig ? signalLabel(-1, setupS, scoreS, lim, stp, tr("Limit entry — ", "دخول بأمر محدد — ")) : na
        line ln = showLevels ? line.new(bar_index, lim, bar_index + pbBars, lim, color = entryCol, style = line.style_dashed, width = 1) : na
        pend := Pending.new(-1, bar_index, lim, stp, setupS, scoreS, lb, ln)
    else
        cur := openTradeAt(-1, setupS, scoreS, close, close + slDistS, bar_index, na)
    newShort := true

// ───────────────────────────── Live trade levels on the price-scale side ─────────────────────────────
var array<label> liveLevelLabels = array.new<label>()
addLevelLabel(array<label> labels, int x, float price, string txt, color bg, float tolerance) =>
    bool merged = false
    if labels.size() > 0
        for i = 0 to labels.size() - 1
            label existing = labels.get(i)
            if not merged and math.abs(label.get_y(existing) - price) <= tolerance
                label.set_text(existing, label.get_text(existing) + "\n" + txt)
                merged := true
    if not merged
        labels.push(label.new(x, price, txt, style = label.style_label_left, color = color.new(bg, 75), textcolor = chart.fg_color, size = size.small))
    merged

if barstate.islast
    while liveLevelLabels.size() > 0
        label.delete(liveLevelLabels.pop())
    if showLive and not na(pend) and na(cur)
        addLevelLabel(liveLevelLabels, bar_index + projBars + 2, pend.limit, (pend.dir == 1 ? "BUY LIMIT " : "SELL LIMIT ") + fmt(pend.limit), entryCol, syminfo.mintick)
    if showLive and not na(cur)
        int xr = bar_index + projBars + 2
        float tolerance = math.max(syminfo.mintick, 0.3 * atr)
        addLevelLabel(liveLevelLabels, xr, cur.entry, "ENTRY " + fmt(cur.entry), entryCol, tolerance)
        addLevelLabel(liveLevelLabels, xr, cur.sl, (cur.sl == cur.sl0 ? "SL " : cur.sl == cur.entry ? "SL (BE) " : "SL (TRAIL) ") + fmt(cur.sl), slCol, tolerance)
        if not cur.hit1
            addLevelLabel(liveLevelLabels, xr, cur.tp1, "TP1 " + fmt(cur.tp1), tpCol, tolerance)
        if not cur.hit2
            addLevelLabel(liveLevelLabels, xr, cur.tp2, "TP2 " + fmt(cur.tp2), tpCol, tolerance)
        if not na(cur.tp3)
            addLevelLabel(liveLevelLabels, xr, cur.tp3, "TP3 " + fmt(cur.tp3), tpCol, tolerance)

// ───────────────────────────── Plots ─────────────────────────────
color emaCol = ema21 >= ema55 ? bullCol : bearCol
p21 = plot(showEma ? ema21 : na, "EMA 21", color = color.new(emaCol, 0), linewidth = 1, display = display.pane + display.data_window)
p55 = plot(showEma ? ema55 : na, "EMA 55", color = color.new(emaCol, 40), linewidth = 1, display = display.pane + display.data_window)
plot(showEma ? ema200 : na, "EMA 200", color = color.new(#f0b90b, 0), linewidth = 2, display = display.pane + display.data_window)
fill(p21, p55, color = showEma ? color.new(emaCol, 82) : na, title = "Trend cloud")
plot(showSt ? stLine : na, "SuperTrend", color = stDir < 0 ? bullCol : bearCol, style = plot.style_linebr, display = display.pane + display.data_window)
bgcolor(showSess and sessApplies and inSessRaw ? color.new(#f0b90b, 93) : na, title = "Active session")
barcolor(colorBars ? (scoreL == 7 ? bullCol : scoreS == 7 ? bearCol : scoreL >= 5 ? color.new(bullCol, 45) : scoreS >= 5 ? color.new(bearCol, 45) : neutCol) : na)
plot(newLong ? 1 : newShort ? -1 : 0, "Signal (1 buy, -1 sell)", display = display.data_window)
plot(scoreL, "Long score", display = display.data_window)
plot(scoreS, "Short score", display = display.data_window)
plot(htfTrend, "HTF trend", display = display.data_window)
plot(anchorTrend, "Anchor trend", display = display.data_window)

// ───────────────────────────── Trend channel ─────────────────────────────
var line chMid = na
var line chUp  = na
var line chDn  = na
var linefill chFill = na
if showChan and barstate.islast and bar_index > chanLen
    float sx = 0.0
    float sy = 0.0
    float sxy = 0.0
    float sxx = 0.0
    for i = 0 to chanLen - 1
        float x = chanLen - 1 - i
        float y = close[i]
        sx += x
        sy += y
        sxy += x * y
        sxx += x * x
    float slope = (chanLen * sxy - sx * sy) / (chanLen * sxx - sx * sx)
    float icpt = (sy - slope * sx) / chanLen
    float se = 0.0
    for i = 0 to chanLen - 1
        float fit = icpt + slope * (chanLen - 1 - i)
        se += math.pow(close[i] - fit, 2)
    float dev = math.sqrt(se / chanLen)
    float yStart = icpt
    float yEnd = icpt + slope * (chanLen - 1)
    int xStart = bar_index - chanLen + 1
    color cc = slope > 0 ? bullCol : bearCol
    line.delete(chMid)
    line.delete(chUp)
    line.delete(chDn)
    linefill.delete(chFill)
    chMid := line.new(xStart, yStart, bar_index, yEnd, color = color.new(cc, 40), style = line.style_dashed, extend = extend.right)
    chUp := line.new(xStart, yStart + chanDev * dev, bar_index, yEnd + chanDev * dev, color = color.new(cc, 0), width = 1, extend = extend.right)
    chDn := line.new(xStart, yStart - chanDev * dev, bar_index, yEnd - chanDev * dev, color = color.new(cc, 0), width = 1, extend = extend.right)
    chFill := linefill.new(chUp, chDn, color.new(cc, 92))

// ───────────────────────────── Pivot trendlines & zones ─────────────────────────────
// Trendline anchors are stored as bar times, so a line can reach back any distance without depending on the
// history buffer of bar_index-based drawings.
var int   ph1t = na
var float ph1y = na
var int   ph2t = na
var float ph2y = na
var int   pl1t = na
var float pl1y = na
var int   pl2t = na
var float pl2y = na
var array<box> resZones = array.new<box>()
var array<box> supZones = array.new<box>()
if not na(ph) and barstate.isconfirmed
    ph2t := ph1t
    ph2y := ph1y
    ph1t := time[pivLen]
    ph1y := ph
    if showZones
        resZones.push(box.new(bar_index - pivLen, ph + 0.15 * atr, bar_index, ph - 0.15 * atr, border_color = color.new(bearCol, 70), border_width = 1, bgcolor = color.new(bearCol, 84), extend = extend.right))
        if resZones.size() > zoneCount
            box.delete(resZones.shift())
if not na(pl) and barstate.isconfirmed
    pl2t := pl1t
    pl2y := pl1y
    pl1t := time[pivLen]
    pl1y := pl
    if showZones
        supZones.push(box.new(bar_index - pivLen, pl + 0.15 * atr, bar_index, pl - 0.15 * atr, border_color = color.new(bullCol, 70), border_width = 1, bgcolor = color.new(bullCol, 84), extend = extend.right))
        if supZones.size() > zoneCount
            box.delete(supZones.shift())
var line tlRes = na
var line tlSup = na
if showTl and barstate.islast
    line.delete(tlRes)
    line.delete(tlSup)
    if not na(ph2t)
        tlRes := line.new(ph2t, ph2y, ph1t, ph1y, xloc = xloc.bar_time, color = ph1y < ph2y ? bearCol : bullCol, width = 1, extend = extend.right)
    if not na(pl2t)
        tlSup := line.new(pl2t, pl2y, pl1t, pl1y, xloc = xloc.bar_time, color = pl1y > pl2y ? bullCol : bearCol, width = 1, extend = extend.right)

// ───────────────────────────── Market sessions (display only) ─────────────────────────────
// Session boxes never feed the signal engine; they only help read the chart.
type SesBox
    box   bx
    float hi
    float lo
    int   startBar
    bool  active = false

bool sesChart = timeframe.isintraday and timeframe.in_seconds() <= 3600
bool inAsia = not na(time(timeframe.period, asiaSesIn, "Asia/Tokyo"))
bool inLdn  = not na(time(timeframe.period, ldnSesIn, "Europe/London"))
bool inNy   = not na(time(timeframe.period, nySesIn, "America/New_York"))
var SesBox sbAsia = SesBox.new()
var SesBox sbLdn  = SesBox.new()
var SesBox sbNy   = SesBox.new()
var array<box>  sesBoxes = array.new<box>()
var array<line> asiaLines = array.new<line>()
var line asiaHiLn = na
var line asiaLoLn = na
var bool asiaLvLive = false

sesStep(SesBox sb, bool inS, string name, color col) =>
    if inS and not sb.active
        sb.hi := high
        sb.lo := low
        sb.startBar := bar_index
        sb.bx := box.new(bar_index, high, bar_index, low, border_color = color.new(col, 45), border_width = 1, bgcolor = color.new(col, sesFill), text = name, text_size = size.tiny, text_color = color.new(col, 20), text_halign = text.align_left, text_valign = text.align_top)
        sesBoxes.push(sb.bx)
        while sesBoxes.size() > 3 * sesDays
            box.delete(sesBoxes.shift())
    else if inS and sb.active
        sb.hi := math.max(sb.hi, high)
        sb.lo := math.min(sb.lo, low)
        sb.bx.set_top(sb.hi)
        sb.bx.set_bottom(sb.lo)
        sb.bx.set_right(bar_index)
    bool ended = sb.active and not inS
    sb.active := inS
    ended

if showSesBox and sesChart
    bool asiaEnded = sesStep(sbAsia, inAsia, "Asia", asiaCol)
    sesStep(sbLdn, inLdn, "London", ldnCol)
    bool nyEnded = sesStep(sbNy, inNy, "New York", nyCol)
    if showAsiaLv
        if asiaEnded
            asiaHiLn := line.new(sbAsia.startBar, sbAsia.hi, bar_index, sbAsia.hi, color = color.new(asiaCol, 25), style = line.style_dotted, width = 1)
            asiaLoLn := line.new(sbAsia.startBar, sbAsia.lo, bar_index, sbAsia.lo, color = color.new(asiaCol, 25), style = line.style_dotted, width = 1)
            asiaLines.push(asiaHiLn)
            asiaLines.push(asiaLoLn)
            while asiaLines.size() > 2 * sesDays
                line.delete(asiaLines.shift())
            asiaLvLive := true
        else if asiaLvLive
            asiaHiLn.set_x2(bar_index)
            asiaLoLn.set_x2(bar_index)
        if nyEnded or (inAsia and not asiaEnded and sbAsia.startBar == bar_index)
            asiaLvLive := false

// ───────────────────────────── Performance panel ─────────────────────────────
panelPosition() =>
    switch panelPos
        "Top left"     => position.top_left
        "Bottom right" => position.bottom_right
        "Bottom left"  => position.bottom_left
        "Middle right" => position.middle_right
        => position.top_right
panelText() =>
    switch panelSize
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

var table pnl = table.new(panelPosition(), 2, 15 + N_SETUPS, bgcolor = color.new(#131722, 15), frame_color = color.new(neutCol, 60), frame_width = 1, border_color = color.new(neutCol, 85), border_width = 1)
cellRow(int r, string k, string v, color vc) =>
    table.cell(pnl, 0, r, k, text_color = color.new(#d1d4dc, 0), text_size = panelText(), text_halign = text.align_left)
    table.cell(pnl, 1, r, v, text_color = vc, text_size = panelText(), text_halign = text.align_right)

if barstate.islast and showPanel
    table.clear(pnl, 0, 0, 1, 14 + N_SETUPS)
    color hd = color.new(#2a2e39, 0)
    table.cell(pnl, 0, 0, "APEX Fusion Pro", text_color = color.white, bgcolor = hd, text_size = panelText(), text_halign = text.align_left)
    table.cell(pnl, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.white, bgcolor = hd, text_size = panelText(), text_halign = text.align_right)
    float n = st.n
    color white = color.new(#d1d4dc, 0)
    cellRow(1, tr("Closed trades", "الصفقات المغلقة"), str.tostring(st.n) + "  (" + str.tostring(st.nL) + " B / " + str.tostring(st.nS) + " S)", white)
    cellRow(2, tr("Win rate (net > 0)", "نسبة النجاح (ربح صافٍ)"), n > 0 ? pct(st.win / n) : "—", n > 0 and st.win / n >= 0.5 ? tpCol : white)
    cellRow(3, tr("TP1 / TP2 / TP3 reached", "وصول TP1 / TP2 / TP3"), n > 0 ? pct(st.tp1 / n) + " / " + pct(st.tp2 / n) + " / " + pct(st.tp3 / n) : "—", white)
    cellRow(4, tr("Full stop-outs", "ضرب الوقف كاملاً"), n > 0 ? pct(st.fullSl / n) : "—", slCol)
    float pf = st.loss > 0 ? st.gross / st.loss : na
    cellRow(5, tr("Profit factor", "معامل الربح PF"), na(pf) ? (st.gross > 0 ? "∞" : "—") : str.tostring(pf, "#.##"), na(pf) or pf >= 1 ? tpCol : slCol)
    cellRow(6, tr("Net / avg per trade", "الصافي / متوسط الصفقة"), n > 0 ? fmtR(st.net) + " / " + fmtR(st.net / n) : "—", st.net >= 0 ? tpCol : slCol)
    cellRow(7, tr("Max drawdown", "أقصى تراجع"), "-" + str.tostring(st.maxDd, "#.##") + "R", white)
    cellRow(8, tr("Long / short net", "صافي الشراء / البيع"), fmtR(st.netL) + " / " + fmtR(st.netS), white)
    cellRow(9, tr("Profile / entry", "الإدارة / الدخول"), str.tostring(k1) + "R / " + str.tostring(k2) + "R / " + str.tostring(k3) + "R" + (trailOn ? " + trail" : "") + (usePullback ? tr(" · limit ", " · محدد ") + str.tostring(pbFrac * 100, "#") + "%" : tr(" · market", " · سوق")), white)
    cellRow(10, tr("Cost per trade · bars replayed", "التكلفة لكل صفقة · شموع أُعيد تمثيلها"), str.tostring(costPct, "#.###") + "% · " + (managedBars > 0 ? str.tostring(100.0 * replayedBars / managedBars, "#") + "%" : "—"), white)
    cellRow(11, tr("Since", "منذ"), na(st.firstTime) ? "—" : str.format_time(st.firstTime, "yyyy-MM-dd", syminfo.timezone), white)
    string state = na(cur) and not na(pend) ? (pend.dir == 1 ? "BUY LIMIT " : "SELL LIMIT ") + fmt(pend.limit) + " (" + pend.setup + ")" : na(cur) ? tr("Flat — waiting for a setup", "لا صفقة — بانتظار إشارة") : (cur.dir == 1 ? "BUY " : "SELL ") + cur.setup + " @ " + fmt(cur.entry) + (cur.hit1 ? " ✅" : "")
    cellRow(12, tr("Now", "الآن"), state, na(cur) ? neutCol : cur.dir == 1 ? buyCol : sellCol)
    cellRow(13, tr("Filters", "الفلاتر"), (useAnchor ? anchorTf + (anchorTrend == 1 ? "↑ " : anchorTrend == -1 ? "↓ " : "→ ") : "") + (useHtfGate ? htf + (htfTrend == 1 ? "↑ " : htfTrend == -1 ? "↓ " : "→ ") : "") + (sessApplies ? (inSessRaw ? tr("session ✓", "الجلسة ✓") : tr("session ✗", "الجلسة ✗")) : ""), white)
    cellRow(14, tr("Backtests", "الاختبارات"), isGold ? (timeframe.in_seconds() >= 3600 ? tr("Gold 1H and above: profitable", "الذهب ساعة فأعلى: رابح") : tr("Gold 5m / 15m: near break-even, small sample", "الذهب 5 و15 دقيقة: قرب التعادل، عيّنة صغيرة")) : (timeframe.in_seconds() >= 14400 ? tr("Other markets: edge on 4H / 1D longs only", "أسواق أخرى: أفضلية في شراء 4 ساعات واليومي فقط") : tr("⚠ Other markets below 4H: not profitable", "⚠ أسواق أخرى تحت 4 ساعات: غير رابح")), isGold ? tpCol : timeframe.in_seconds() >= 14400 ? white : slCol)
    if showSetRows
        int r = 15
        for i = 0 to N_SETUPS - 1
            int sn = setN.get(i)
            if sn > 0
                cellRow(r, "  " + setupNames.get(i), str.tostring(sn) + " | " + pct(setWin.get(i) / float(sn)) + " | " + fmtR(setR.get(i) / sn), sn >= 10 ? white : color.new(neutCol, 30))
                r += 1

// ───────────────────────────── Alerts ─────────────────────────────
alertcondition(newLong, "APEX FUSION BUY", "APEX FUSION BUY signal {{ticker}} {{interval}} @ {{close}} (below 1H: limit order placed)")
alertcondition(evFill, "APEX FUSION entry filled", "APEX FUSION limit entry filled {{ticker}} {{interval}}")
alertcondition(newShort, "APEX FUSION SELL", "APEX FUSION SELL signal {{ticker}} {{interval}} @ {{close}} (below 1H: limit order placed)")
alertcondition(evCancel, "APEX FUSION limit cancelled", "APEX FUSION pending limit entry cancelled {{ticker}} {{interval}} — cancel the order at your broker")
alertcondition(evTp1 or evTp2 or evTp3, "APEX FUSION target hit", "APEX FUSION target hit {{ticker}} {{interval}}")
alertcondition(evSl, "APEX FUSION stop hit", "APEX FUSION stop hit {{ticker}} {{interval}}")
alertcondition(evExit, "APEX FUSION trade closed (BE / trail / reverse / time)", "APEX FUSION trade closed {{ticker}} {{interval}}")

// Order within one bar: a cancelled pending order, a fill, the exit / target event of the trade that was open
// (with its side and the real fill price), then the new signal.
if evCancel
    alert('{"event":"CANCEL","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '"}', alert.freq_once_per_bar_close)
if evFill
    float fRisk = (fillPx - fillSl) * fillDir
    float fTp3 = fillPx + fillDir * k3 * fRisk
    alert('{"event":"FILLED","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","entry":' + fmt(fillPx) + ',"sl":' + fmt(fillSl) + ',"tp1":' + fmt(fillPx + fillDir * k1 * fRisk) + ',"tp2":' + fmt(fillPx + fillDir * k2 * fRisk) + ',"tp3":' + (fTp3 > syminfo.mintick ? fmt(fTp3) : "null") + '}', alert.freq_once_per_bar_close)
if evTp1 or evTp2 or evTp3 or evSl or evExit
    string evName = evSl ? "STOP" : evExit ? "EXIT" : evTp3 ? "TP3" : evTp2 ? "TP2" : "TP1"
    string evTargets = (evTp1 ? "1" : "") + (evTp2 ? "2" : "") + (evTp3 ? "3" : "")
    // Price of the event itself: the fill of a close on this bar, otherwise the target level that was reached.
    bool closedNow = st.lastBar == bar_index
    bool sameTrade = not na(cur) and cur.entryBar < bar_index
    float evPrice = closedNow ? st.lastPx : evTp2 and sameTrade ? cur.tp2 : evTp1 and sameTrade ? cur.tp1 : close
    alert('{"event":"' + evName + '","side":"' + (evDir == 1 ? "LONG" : "SHORT") + '","targets_hit":"' + evTargets + '","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","price":' + fmt(evPrice) + (na(lastR) ? "" : ',"R":' + str.tostring(lastR, "#.###")) + '}', alert.freq_once_per_bar_close)
if (newLong or newShort) and not na(pend)
    float pdist = math.abs(pend.limit - pend.stop)
    alert('{"signal":"' + (newLong ? "BUY" : "SELL") + '","type":"limit","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","setup":"' + pend.setup + '","score":' + str.tostring(pend.score) + ',"entry":' + fmt(pend.limit) + ',"sl":' + fmt(pend.stop) + ',"tp1":' + fmt(pend.limit + pend.dir * k1 * pdist) + ',"tp2":' + fmt(pend.limit + pend.dir * k2 * pdist) + ',"tp3":' + (pend.limit + pend.dir * k3 * pdist > syminfo.mintick ? fmt(pend.limit + pend.dir * k3 * pdist) : "null") + ',"valid_bars":' + str.tostring(pbBars) + '}', alert.freq_once_per_bar_close)
if (newLong or newShort) and na(pend) and not na(cur)
    alert('{"signal":"' + (newLong ? "BUY" : "SELL") + '","type":"market","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","setup":"' + cur.setup + '","score":' + str.tostring(cur.score) + ',"entry":' + fmt(cur.entry) + ',"sl":' + fmt(cur.sl) + ',"tp1":' + fmt(cur.tp1) + ',"tp2":' + fmt(cur.tp2) + ',"tp3":' + (na(cur.tp3) ? "null" : fmt(cur.tp3)) + '}', alert.freq_once_per_bar_close)
