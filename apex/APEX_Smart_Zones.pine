// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// APEX Smart Zones — support / resistance zones from confirmed swing highs and lows, with touch entries.
// Modelled on a closed-source zone indicator: its zones on gold 15m (9 Nov 2026) were matched against OANDA data
// and all five visible zones coincide with swing pivots of strength 20 inside the last 250 bars
// (4146.92, 4134.14-4138.27, 4084.48, 4054.40, 4029.12-4029.83). The zone thickness and the trade rules are an
// approximation: the original's code is not public.
// Rules: the three nearest resistance zones above price and the three nearest support zones below it are drawn.
// The first touch of a zone opens a trade against the move: entry at the zone edge, stop one ATR beyond the entry
// (read off the original's price-scale labels: 4056.245 / 4048.813 around the 4054.39 low), target = the nearest
// zone on the other side. One trade at a time, each zone is traded once. Evaluated on bar close.
// The price scale shows the next sell plan and the next buy plan: entry (grey), stop (red), target (green).
// Measured on 16.8 years of 1-minute gold data (2010-2019 / 2020-2026, cost 0.01%), this rule:
//   15m, target = opposite zone: 1.5 trades a day, 10% / 11% winners, -0.28R / -0.22R per trade, PF 0.72 / 0.78
//   15m, target = 1R:            2.1 trades a day, 40% / 44% winners, -0.31R / -0.20R per trade, PF 0.53 / 0.67
//    5m, target = opposite zone: 4.5 trades a day, 10% / 12% winners, -0.36R / -0.26R per trade, PF 0.66 / 0.75
//   Every variant tested lost money. With a small target and a wide stop (0.5 ATR / 5-8 ATR) the win rate is
//   85-92% and the result is still negative (PF 0.44 / 0.59).
// No table.
//@version=6
indicator("APEX Smart Zones", shorttitle = "APEX ZONES", overlay = true, max_boxes_count = 100, max_labels_count = 200)

pivLen    = input.int(20, "قوة القمة / القاع · Pivot strength", minval = 3, maxval = 50)
lookback  = input.int(250, "عمر المنطقة بالشموع · Zone life (bars)", minval = 50, maxval = 2000)
wK        = input.float(0.25, "نصف سماكة المنطقة × ATR · Zone half-width", minval = 0.05, maxval = 2, step = 0.05)
maxRes    = input.int(3, "عدد مناطق المقاومة · Resistance zones", minval = 1, maxval = 6)
maxSup    = input.int(3, "عدد مناطق الدعم · Support zones", minval = 1, maxval = 6)
slAtr     = input.float(1.0, "الوقف × ATR من الدخول · Stop distance from entry", minval = 0.1, maxval = 10, step = 0.1)
showPlan  = input.bool(true, "وسوم الخطة على المحور · Plan labels on the price scale")
showTrades = input.bool(true, "رسم الصفقات · Draw trades")
keepTrades = input.int(6, "عدد الصفقات المحفوظة · Keep last N trades", minval = 0, maxval = 30)
resCol    = input.color(#f23645, "ألوان المقاومة · الدعم", inline = "c")
supCol    = input.color(#22ab94, "", inline = "c")

fmt(float v) => str.tostring(v, format.mintick)

float atr = ta.atr(14)
float atrPrev = atr[1]
float closePrev = close[1]
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)

// Zone store: level, bar on which the pivot was confirmed, and whether the zone has already been traded.
var array<float> resLv = array.new<float>()
var array<int>   resBorn = array.new<int>()
var array<bool>  resUsed = array.new<bool>()
var array<float> supLv = array.new<float>()
var array<int>   supBorn = array.new<int>()
var array<bool>  supUsed = array.new<bool>()

// Indexes of the nearest zones on one side of a reference price (side = 1: above, -1: below), nearest first.
nearest(array<float> lv, float ref, float w, int side, int maxN) =>
    array<int> sel = array.new<int>()
    float last = na
    if lv.size() > 0
        for k = 1 to maxN
            int bi = -1
            float best = na
            for i = 0 to lv.size() - 1
                float v = lv.get(i)
                bool onSide = side == 1 ? v - w > ref : v + w < ref
                bool beyond = na(last) or (side == 1 ? v > last : v < last)
                bool better = na(best) or (side == 1 ? v < best : v > best)
                if onSide and beyond and better
                    best := v
                    bi := i
            if bi >= 0
                sel.push(bi)
                last := best
    sel

// A zone is dropped when it is older than the lookback or when a bar closes beyond it.
prune(array<float> lv, array<int> born, array<bool> used, bool isRes, float w) =>
    if lv.size() > 0
        for i = lv.size() - 1 to 0
            bool old = bar_index - born.get(i) > lookback
            bool broken = isRes ? close > lv.get(i) + w : close < lv.get(i) - w
            if old or broken
                lv.remove(i)
                born.remove(i)
                used.remove(i)

// ───────────────────────────── Trades ─────────────────────────────
type Trade
    int   dir
    int   entryBar
    float entry
    float sl
    float tp
    box   bxRisk
    box   bxReward
    label lbSig
    label lbSl
    label lbTp

var Trade cur = na
var array<Trade> closedTrades = array.new<Trade>()

deleteTrade(Trade t) =>
    box.delete(t.bxRisk)
    box.delete(t.bxReward)
    label.delete(t.lbSig)
    label.delete(t.lbSl)
    label.delete(t.lbTp)

extendTrade(Trade t, int x) =>
    if not na(t.bxRisk)
        t.bxRisk.set_right(x)
        t.bxReward.set_right(x)
        t.lbSl.set_x(x)
        t.lbTp.set_x(x)

openTrade(int d, float e, float stopPx, float target) =>
    Trade t = Trade.new(d, bar_index, e, stopPx, target)
    if showTrades
        int xr = bar_index + 3
        t.bxRisk := box.new(bar_index, math.max(e, stopPx), xr, math.min(e, stopPx), border_color = color.new(resCol, 100), bgcolor = color.new(resCol, 45))
        t.bxReward := box.new(bar_index, math.max(e, target), xr, math.min(e, target), border_color = color.new(supCol, 100), bgcolor = color.new(supCol, 60))
        t.lbSl := label.new(xr, stopPx, "SL " + fmt(stopPx), style = label.style_label_left, color = color.new(resCol, 10), textcolor = color.white, size = size.small)
        t.lbTp := label.new(xr, target, "TP " + fmt(target), style = label.style_label_left, color = color.new(supCol, 10), textcolor = color.white, size = size.small)
        t.lbSig := label.new(bar_index, d == 1 ? math.min(low, stopPx) : math.max(high, stopPx), d == 1 ? "شراء BUY" : "بيع SELL", style = d == 1 ? label.style_label_up : label.style_label_down, color = d == 1 ? supCol : resCol, textcolor = color.white, size = size.small, tooltip = "Entry " + fmt(e))
    t

finishTrade(Trade t, bool won) =>
    extendTrade(t, bar_index)
    if not na(t.lbSl)
        if won
            t.lbTp.set_text("✅ TP " + fmt(t.tp))
        else
            t.lbSl.set_text("❌ SL " + fmt(t.sl))
    closedTrades.push(t)
    while closedTrades.size() > keepTrades
        deleteTrade(closedTrades.shift())

bool evSell = false
bool evBuy = false
bool evTp = false
bool evSl = false

if barstate.isconfirmed
    // 1) Manage the open trade on bars after its entry bar (stop first when a bar touches both).
    if not na(cur) and bar_index > cur.entryBar
        if cur.dir == 1 ? low <= cur.sl : high >= cur.sl
            evSl := true
            finishTrade(cur, false)
            cur := na
        else if cur.dir == 1 ? high >= cur.tp : low <= cur.tp
            evTp := true
            finishTrade(cur, true)
            cur := na
        else
            extendTrade(cur, bar_index + 3)

    // 2) Entry: first touch of one of the nearest zones as they stood at the previous bar's close.
    if na(cur) and not na(atrPrev) and atrPrev > 0
        float w1 = wK * atrPrev
        float stopDist = slAtr * atrPrev
        array<int> rs = nearest(resLv, closePrev, w1, 1, maxRes)
        array<int> ss = nearest(supLv, closePrev, w1, -1, maxSup)
        bool taken = false
        if rs.size() > 0
            for k = 0 to rs.size() - 1
                int idx = rs.get(k)
                float e = resLv.get(idx) - w1
                if not taken and not resUsed.get(idx) and high >= e and open < e
                    taken := true
                    resUsed.set(idx, true)
                    if ss.size() > 0
                        float stopPx = e + stopDist
                        float target = supLv.get(ss.get(0)) + w1
                        if e - target > 0.3 * (stopPx - e)
                            cur := openTrade(-1, e, stopPx, target)
                            evSell := true
                            // Unknown order inside the entry bar: if it also reached the stop, count the stop.
                            if high >= stopPx
                                evSl := true
                                finishTrade(cur, false)
                                cur := na
        if not taken and ss.size() > 0
            for k = 0 to ss.size() - 1
                int idx = ss.get(k)
                float e = supLv.get(idx) + w1
                if not taken and not supUsed.get(idx) and low <= e and open > e
                    taken := true
                    supUsed.set(idx, true)
                    if rs.size() > 0
                        float stopPx = e - stopDist
                        float target = resLv.get(rs.get(0)) - w1
                        if target - e > 0.3 * (e - stopPx)
                            cur := openTrade(1, e, stopPx, target)
                            evBuy := true
                            if low <= stopPx
                                evSl := true
                                finishTrade(cur, false)
                                cur := na

    // 3) Update the zone store with this bar: new confirmed pivots, then drop old or broken zones.
    if not na(ph)
        resLv.push(ph)
        resBorn.push(bar_index)
        resUsed.push(false)
    if not na(pl)
        supLv.push(pl)
        supBorn.push(bar_index)
        supUsed.push(false)
    if not na(atr)
        prune(resLv, resBorn, resUsed, true, wK * atr)
        prune(supLv, supBorn, supUsed, false, wK * atr)

// ───────────────────────────── Zone drawing (redrawn on the last bar) ─────────────────────────────
var array<box> zoneBoxes = array.new<box>()
if barstate.islast and not na(atr)
    while zoneBoxes.size() > 0
        box.delete(zoneBoxes.pop())
    float w = wK * atr
    array<int> rs = nearest(resLv, close, w, 1, maxRes)
    array<int> ss = nearest(supLv, close, w, -1, maxSup)
    if rs.size() > 0
        for k = 0 to rs.size() - 1
            float lv = resLv.get(rs.get(k))
            zoneBoxes.push(box.new(resBorn.get(rs.get(k)) - pivLen, lv + w, bar_index + 12, lv - w, border_color = color.new(resCol, 10), border_width = 1, bgcolor = color.new(resCol, 75), text = "RESISTANCE  " + fmt(lv), text_size = size.small, text_color = color.white, text_halign = text.align_right, text_valign = text.align_center))
    if ss.size() > 0
        for k = 0 to ss.size() - 1
            float lv = supLv.get(ss.get(k))
            zoneBoxes.push(box.new(supBorn.get(ss.get(k)) - pivLen, lv + w, bar_index + 12, lv - w, border_color = color.new(supCol, 10), border_width = 1, bgcolor = color.new(supCol, 75), text = "SUPPORT  " + fmt(lv), text_size = size.small, text_color = color.white, text_halign = text.align_right, text_valign = text.align_center))

// ───────────────────────────── Next plan on the price scale ─────────────────────────────
// Nearest untraded resistance (sell plan) and support (buy plan) as of this bar: entry, stop, target.
float planSellE = na
float planSellSl = na
float planSellTp = na
float planBuyE = na
float planBuySl = na
float planBuyTp = na
if showPlan and not na(atr) and atr > 0
    float wp = wK * atr
    array<int> prs = nearest(resLv, close, wp, 1, maxRes)
    array<int> pss = nearest(supLv, close, wp, -1, maxSup)
    if prs.size() > 0 and pss.size() > 0
        planSellE := resLv.get(prs.get(0)) - wp
        planSellSl := planSellE + slAtr * atr
        planSellTp := supLv.get(pss.get(0)) + wp
        planBuyE := supLv.get(pss.get(0)) + wp
        planBuySl := planBuyE - slAtr * atr
        planBuyTp := resLv.get(prs.get(0)) - wp
plot(planSellE, "Sell entry", color = color.gray, display = display.price_scale)
plot(planSellSl, "Sell stop", color = resCol, display = display.price_scale)
plot(planSellTp, "Sell target", color = supCol, display = display.price_scale)
plot(planBuyE, "Buy entry", color = color.gray, display = display.price_scale)
plot(planBuySl, "Buy stop", color = resCol, display = display.price_scale)
plot(planBuyTp, "Buy target", color = supCol, display = display.price_scale)

alertcondition(evSell, "APEX ZONES SELL", "APEX ZONES: price touched a resistance zone {{ticker}} {{interval}}")
alertcondition(evBuy, "APEX ZONES BUY", "APEX ZONES: price touched a support zone {{ticker}} {{interval}}")
alertcondition(evTp, "APEX ZONES target hit", "APEX ZONES target hit {{ticker}} {{interval}}")
alertcondition(evSl, "APEX ZONES stop hit", "APEX ZONES stop hit {{ticker}} {{interval}}")
