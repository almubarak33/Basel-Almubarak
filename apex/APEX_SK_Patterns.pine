// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// APEX SK Patterns — 0-A-B continuation patterns with Fibonacci targets.
// Modelled on the settings of a closed-source indicator (sensitivity 5, B between 0.5 and 0.667, targets 1.272 /
// 1.618 / 2 / 2.618, ADX >= 18, long and short). Its code is not public: the rules below are an approximation.
// Pattern (long; short is the mirror): a confirmed swing low "0", a confirmed swing high "A", then a pullback "B"
// that retraces 50% to 66.7% of 0-A. The entry is the break of A while the pullback is inside that band.
// Targets are 0 + k x (A - 0). The stop is point 0 (or point B).
// Non-repainting: swings are confirmed pivots, the pullback is tracked bar by bar, everything is evaluated on bar
// close. (The original offers a "live" detection mode; a live pivot can repaint, this script does not use one.)
// Measured on 16.8 years of 1-minute gold data (2010-2019 / 2020-2026, cost 0.01%), stop at point 0:
//    4H: 0.07 trades a day, TP1 before the stop in 85% / 78% of trades
//    1H: 0.22 trades a day, 79% / 78%        15m: 0.9 trades a day, 79% / 81%        5m: 2.4 trades a day, 80% / 78%
//   Profit per trade, a quarter closed at each target, stop to entry after TP1:
//    4H +0.09R / +0.05R,  1H +0.01R / +0.02R,  15m +0.02R / +0.03R,  5m -0.01R / -0.04R.
//   TP1 is 0.27 of the risk, so about 79% winners is what a random entry gives; the edge measured is close to zero.
// After TP1 the stop moves to the entry price (the rule used in the measurements above).
// No table.
//@version=6
indicator("APEX SK Patterns", shorttitle = "APEX SK", overlay = true, max_labels_count = 500, max_lines_count = 300, max_boxes_count = 100)

const string S_ZERO = "Point 0 · النقطة 0"
const string S_B = "Point B · النقطة B"

useLong   = input.bool(true, "LONG · شراء", inline = "d")
useShort  = input.bool(true, "SHORT · بيع", inline = "d2")
sens      = input.int(5, "الحساسية · Sensitivity (pivot strength)", minval = 2, maxval = 50)
bMin      = input.float(0.5, "B Min", minval = 0.1, maxval = 0.95, step = 0.01)
bMax      = input.float(0.667, "B Max", minval = 0.15, maxval = 0.99, step = 0.01)
k1        = input.float(1.272, "TP1", minval = 1.01, step = 0.01)
k2        = input.float(1.618, "TP2", minval = 1.02, step = 0.01)
k3        = input.float(2.0, "TP3", minval = 1.03, step = 0.01)
k4        = input.float(2.618, "TP4", minval = 1.04, step = 0.01)
useAdx    = input.bool(true, "فلتر ADX · ADX filter")
adxMin    = input.float(18, "ADX Min", minval = 1)
stopMode  = input.string(S_ZERO, "الوقف · Stop", options = [S_ZERO, S_B])
expiryBars = input.int(100, "صلاحية النموذج بالشموع · Pattern expiry (bars)", minval = 5)
showBox   = input.bool(true, "صندوق 0-A · 0-A box")
lineLen   = input.int(10, "طول خط المستوى · Level line length", minval = 2, maxval = 100)
entryCol  = input.color(#00bcd4, "الدخول · الأهداف · الهدف المحقق · الوقف", inline = "c")
tpCol     = input.color(#f9d423, "", inline = "c")
hitCol    = input.color(#00b074, "", inline = "c")
slCol     = input.color(#ff1744, "", inline = "c")

fmt(float v) => str.tostring(v, format.mintick)

if barstate.isfirst
    if not (bMin < bMax)
        runtime.error("B Min must be below B Max.")
    if not (k1 < k2 and k2 < k3 and k3 < k4)
        runtime.error("Targets must satisfy TP1 < TP2 < TP3 < TP4.")

[diP, diM, adx] = ta.dmi(14, 14)
float adxPrev = adx[1]
float ph = ta.pivothigh(high, sens, sens)
float pl = ta.pivotlow(low, sens, sens)

// ───────────────────────────── Swings (confirmed pivots, alternating) ─────────────────────────────
var int   lastType = 0
var float lastPx = na
var int   lastBar = na
var float prevPx = na
var int   prevBar = na

// ───────────────────────────── Pattern being watched ─────────────────────────────
var bool  suOn = false
var int   suDir = 0
var float su0 = na
var float suA = na
var int   su0Bar = na
var int   suABar = na
var float suExt = na
var int   suExtBar = na
var int   suBorn = na

// ───────────────────────────── Trades ─────────────────────────────
type Trade
    int   dir
    float entry
    float sl
    float tp1
    float tp2
    float tp3
    float tp4
    int   hits = 0
    box   bxRisk
    box   bxReward
    line  lnEntry
    line  lnSl
    line  ln1
    line  ln2
    line  ln3
    line  ln4
    label lbEntry
    label lbSl
    label lb1
    label lb2
    label lb3
    label lb4

var array<Trade> trades = array.new<Trade>()

// Soft tag at the right edge of the trade box (pending levels are pale, reached targets turn solid).
softTag(int x, float y, string txt, color col) =>
    label.new(x, y, txt, style = label.style_label_left, color = color.new(col, 82), textcolor = color.new(col, 0), size = size.small)

markHit(label lb, line ln, int k, float px) =>
    lb.set_text("✓ TP" + str.tostring(k) + " " + fmt(px))
    lb.set_color(color.new(hitCol, 0))
    lb.set_textcolor(color.white)
    ln.set_color(color.new(hitCol, 0))

extendTrade(Trade t, int x) =>
    t.bxRisk.set_right(x)
    t.bxReward.set_right(x)
    t.lnEntry.set_x2(x)
    t.lnSl.set_x2(x)
    t.ln1.set_x2(x)
    t.ln2.set_x2(x)
    t.ln3.set_x2(x)
    t.ln4.set_x2(x)
    t.lbEntry.set_x(x)
    t.lbSl.set_x(x)
    t.lb1.set_x(x)
    t.lb2.set_x(x)
    t.lb3.set_x(x)
    t.lb4.set_x(x)

bool evLong = false
bool evShort = false
bool evTp = false
bool evSl = false
bool evBe = false

if barstate.isconfirmed
    // 1) Manage open trades (bars after the entry bar; stop first when a bar touches both).
    if trades.size() > 0
        for i = trades.size() - 1 to 0
            Trade t = trades.get(i)
            if t.dir == 1 ? low <= t.sl : high >= t.sl
                if t.hits == 0
                    t.lbSl.set_text("✗ SL " + fmt(t.sl))
                    t.lbSl.set_color(color.new(slCol, 0))
                    t.lbSl.set_textcolor(color.white)
                    evSl := true
                else
                    // stop already at the entry price: the remainder leaves without a loss
                    t.lbSl.set_text("BE " + fmt(t.sl))
                    evBe := true
                extendTrade(t, bar_index)
                trades.remove(i)
            else
                if t.hits == 0 and (t.dir == 1 ? high >= t.tp1 : low <= t.tp1)
                    t.hits := 1
                    markHit(t.lb1, t.ln1, 1, t.tp1)
                    evTp := true
                    // stop to the entry price after TP1
                    t.sl := t.entry
                    t.lnSl.set_y1(t.entry)
                    t.lnSl.set_y2(t.entry)
                    t.lbSl.set_y(t.entry)
                    t.lbSl.set_text("SL → BE")
                    t.bxRisk.set_bgcolor(color.new(slCol, 100))
                    t.lbEntry.set_text("")
                    t.lbEntry.set_color(color.new(entryCol, 100))
                if t.hits == 1 and (t.dir == 1 ? high >= t.tp2 : low <= t.tp2)
                    t.hits := 2
                    markHit(t.lb2, t.ln2, 2, t.tp2)
                    evTp := true
                if t.hits == 2 and (t.dir == 1 ? high >= t.tp3 : low <= t.tp3)
                    t.hits := 3
                    markHit(t.lb3, t.ln3, 3, t.tp3)
                    evTp := true
                if t.hits == 3 and (t.dir == 1 ? high >= t.tp4 : low <= t.tp4)
                    t.hits := 4
                    markHit(t.lb4, t.ln4, 4, t.tp4)
                    evTp := true
                    extendTrade(t, bar_index)
                    trades.remove(i)
                else
                    extendTrade(t, math.max(bar_index + 2, t.lnEntry.get_x1() + lineLen))

    // 2) Watch the current pattern: pullback depth, break of A, expiry.
    if suOn and bar_index > suBorn
        float rng = (suA - su0) * suDir
        float retr = (suA - suExt) * suDir / rng
        bool broke = suDir == 1 ? high >= suA : low <= suA
        if retr > bMax or bar_index - suBorn > expiryBars
            suOn := false
        else if broke
            suOn := false
            bool sideOk = suDir == 1 ? useLong : useShort
            bool adxOk = not useAdx or adxPrev >= adxMin
            if retr >= bMin and sideOk and adxOk
                float e = suDir == 1 ? math.max(open, suA) : math.min(open, suA)
                float stopPx = stopMode == S_ZERO ? su0 : suExt
                if (e - stopPx) * suDir > 0
                    Trade t = Trade.new(suDir, e, stopPx, su0 + k1 * (suA - su0), su0 + k2 * (suA - su0), su0 + k3 * (suA - su0), su0 + k4 * (suA - su0))
                    int xr = bar_index + lineLen
                    t.bxRisk := box.new(bar_index, math.max(e, stopPx), xr, math.min(e, stopPx), border_color = color.new(slCol, 100), bgcolor = color.new(slCol, 90))
                    t.bxReward := box.new(bar_index, math.max(e, t.tp4), xr, math.min(e, t.tp4), border_color = color.new(hitCol, 100), bgcolor = color.new(hitCol, 92))
                    t.lnEntry := line.new(bar_index, e, xr, e, color = color.new(entryCol, 20), width = 1)
                    t.lnSl := line.new(bar_index, stopPx, xr, stopPx, color = color.new(slCol, 20), width = 1, style = line.style_dashed)
                    t.ln1 := line.new(bar_index, t.tp1, xr, t.tp1, color = color.new(hitCol, 40), width = 1, style = line.style_dotted)
                    t.ln2 := line.new(bar_index, t.tp2, xr, t.tp2, color = color.new(hitCol, 40), width = 1, style = line.style_dotted)
                    t.ln3 := line.new(bar_index, t.tp3, xr, t.tp3, color = color.new(hitCol, 40), width = 1, style = line.style_dotted)
                    t.ln4 := line.new(bar_index, t.tp4, xr, t.tp4, color = color.new(hitCol, 40), width = 1, style = line.style_dotted)
                    t.lbSl := softTag(xr, stopPx, "SL " + fmt(stopPx), slCol)
                    t.lbEntry := softTag(xr, e, "ENTRY " + fmt(e), entryCol)
                    t.lb1 := softTag(xr, t.tp1, "TP1 " + fmt(t.tp1), hitCol)
                    t.lb2 := softTag(xr, t.tp2, "TP2 " + fmt(t.tp2), hitCol)
                    t.lb3 := softTag(xr, t.tp3, "TP3 " + fmt(t.tp3), hitCol)
                    t.lb4 := softTag(xr, t.tp4, "TP4 " + fmt(t.tp4), hitCol)
                    trades.push(t)
                    evLong := suDir == 1
                    evShort := suDir == -1
                    color pc = suDir == 1 ? hitCol : slCol
                    label.new(bar_index, suDir == 1 ? math.min(low, stopPx) : math.max(high, stopPx), suDir == 1 ? "BUY" : "SELL", style = suDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(pc, 25), textcolor = color.white, size = size.small, tooltip = "Entry " + fmt(e))
                    label.new(su0Bar, su0, "0", style = label.style_none, textcolor = pc, size = size.normal)
                    label.new(suABar, suA, "A", style = label.style_none, textcolor = pc, size = size.normal)
                    label.new(suExtBar, suExt, "B", style = label.style_none, textcolor = pc, size = size.normal)
                    if showBox
                        box.new(su0Bar, math.max(su0, suA), bar_index, math.min(su0, suA), border_color = color.new(pc, 60), bgcolor = color.new(pc, 88))
        else
            // deepest point of the pullback so far
            if suDir == 1 ? low < suExt : high > suExt
                suExt := suDir == 1 ? low : high
                suExtBar := bar_index

    // 3) New confirmed swings; a new point A starts a new pattern.
    bool newA = false
    if not na(ph)
        if lastType == 1
            if ph > lastPx
                lastPx := ph
                lastBar := bar_index - sens
                newA := true
        else
            prevPx := lastPx
            prevBar := lastBar
            lastType := 1
            lastPx := ph
            lastBar := bar_index - sens
            newA := true
    if not na(pl)
        if lastType == -1
            if pl < lastPx
                lastPx := pl
                lastBar := bar_index - sens
                newA := true
        else
            prevPx := lastPx
            prevBar := lastBar
            lastType := -1
            lastPx := pl
            lastBar := bar_index - sens
            newA := true
    if newA and not na(prevPx) and (lastPx - prevPx) * lastType > 0
        suOn := true
        suDir := lastType
        su0 := prevPx
        suA := lastPx
        su0Bar := prevBar
        suABar := lastBar
        suBorn := bar_index
        // deepest pullback among the bars after A that are already closed
        suExt := suDir == 1 ? low : high
        suExtBar := bar_index
        for i = 1 to sens - 1
            if suDir == 1 ? low[i] < suExt : high[i] > suExt
                suExt := suDir == 1 ? low[i] : high[i]
                suExtBar := bar_index - i

alertcondition(evLong, "APEX SK BUY", "APEX SK: break of A, long {{ticker}} {{interval}} @ {{close}}")
alertcondition(evShort, "APEX SK SELL", "APEX SK: break of A, short {{ticker}} {{interval}} @ {{close}}")
alertcondition(evTp, "APEX SK target hit", "APEX SK target hit {{ticker}} {{interval}}")
alertcondition(evBe, "APEX SK breakeven exit", "APEX SK: remainder closed at the entry price {{ticker}} {{interval}}")
alertcondition(evSl, "APEX SK stop hit", "APEX SK stop hit {{ticker}} {{interval}}")
